# The Elody UI ontology — the `elody:` terms a *.ui.ttl declaration may use,
# layered on the W3C SHACL 1.2 UI vocabulary (shui:) and DASH (dash:).
#
# Layering rule (one term per meaning, lowest layer wins):
#   sh:    what a property IS            (path, datatype, class, cardinality, order, group, name, description, defaultValue)
#   shui:  how it is EDITED or VIEWED    (editor, viewer, propertyRole LabelRole)
#   dash:  what shui does not say        (readOnly, hidden, DescriptionRole, IconRole, KeyInfoRole)
#   elody: what only the platform knows  (listings, view modes, panels, filters, actions, flows,
#                                          and Elody widgets as shui editors/viewers)
# A term lives in elody: only when no sh:/shui:/dash: term carries the meaning, and every
# term's rdfs:comment says why. Retired terms stay as owl:DeprecatedProperty with their
# replacement, and the generator accepts them for one release (`check` warns).
#
# Enumerations are instances (R4): a declaration says `elody:mode elody:ListView`, never the
# string "ViewModesList".
#
# This is the vocabulary: what a declaration may say. How Elody implements it — the
# literal of an enumeration in the GraphQL schema, the PWA widget an editor renders as,
# the schema field of an element — lives with the generator, in the implementation
# bindings (elody-generator, ontology/elody-ui.bindings.ttl), and changes with the
# platform rather than with this vocabulary.

@prefix elody:   <https://elody.eu/ns/ui#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix shui:    <http://www.w3.org/ns/shacl-ui/> .
@prefix dash:    <http://datashapes.org/dash#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann:    <http://purl.org/vocab/vann/> .

<https://elody.eu/ns/ui> a owl:Ontology ;
  rdfs:label "Elody UI ontology"@en ;
  rdfs:comment "The platform-specific presentation terms of an Elody UI declaration, layered on SHACL 1.2 UI (shui:) and DASH (dash:). The standard subset of a declaration stays readable by any SHACL-UI tool; the elody: subset describes listings, view modes, panels, filters, actions and flows, which the standard has no terms for."@en ;
  owl:versionInfo "0.3.0" ;
  owl:versionIRI <https://elody.eu/ns/ui/0.3.0> ;
  owl:priorVersion <https://elody.eu/ns/ui/0.2.0> ;
  owl:imports <http://www.w3.org/ns/shacl-ui/> , <http://datashapes.org/dash> ;
  vann:preferredNamespacePrefix "elody" ;
  vann:preferredNamespaceUri "https://elody.eu/ns/ui#" ;
  dcterms:created "2026-10-02"^^xsd:date ;
  dcterms:modified "2026-10-08"^^xsd:date ;
  dcterms:license <https://opensource.org/licenses/MIT> ;
  dcterms:creator <https://inuits.eu/> .

# =============================================================================
# 1. Ontology-internal annotation terms
# =============================================================================

elody:fallbackWidget a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "standard fallback widget"@en ;
  rdfs:domain elody:Widget ; rdfs:range owl:Thing ;
  rdfs:comment "The standard shui: editor or viewer an Elody widget specialises. A renderer that does not know Elody falls back to it; shui's scoring then picks the standard widget. No standard term: shui has no specialisation relation between editors."@en .

elody:directive a owl:AnnotationProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "generator directive"@en ;
  rdfs:range xsd:boolean ;
  rdfs:comment "Marks a term that steers the generator rather than describing the UI (emit, documents, graphqlType). Directives disappear as the generator learns to derive them."@en .

# =============================================================================
# 2. Widgets: Elody editors and viewers as shui editors and viewers (R2)
# =============================================================================
# shui: editors are individuals of shui:Editor; Elody widgets are individuals too, typed
# elody:Editor / elody:Viewer (subclasses of shui:Editor / shui:Viewer) and selected through
# the standard predicates shui:editor / shui:viewer. Never elody:widget.

elody:Widget a owl:Class ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "Elody widget"@en ;
  rdfs:comment "An editor or viewer only Elody renders. Each names the standard widget it falls back to."@en .

elody:Editor a owl:Class ; rdfs:subClassOf shui:Editor , elody:Widget ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "Elody editor"@en ;
  rdfs:comment "An input widget of the Elody platform, usable where shui:editor expects a shui:Editor."@en .

elody:Viewer a owl:Class ; rdfs:subClassOf shui:Viewer , elody:Widget ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "Elody viewer"@en ;
  rdfs:comment "A read-mode widget of the Elody platform, usable where shui:viewer expects a shui:Viewer."@en .

# -- the standard editors --------------------------------------------------------
# Which shui: editors Elody implements, and as which widget, is in the implementation
# bindings. shui:SubClassEditor offers sh:rootClass and its subclasses (read when
# generating, or live with elody:classSource); shui:RichTextEditor is a rich-text
# element in the detail panel (elody:WysiwygElement). Not implemented:
# shui:BlankNodeEditor.

# -- Elody editors -------------------------------------------------------------
elody:EntityPickerEditor a elody:Editor ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "entity picker"@en ; elody:fallbackWidget shui:AutoCompleteEditor ;
  rdfs:comment "Search-and-pick an Elody entity in a modal listing with the platform's filters. Specialises AutoComplete: the search is the Elody filter engine, not shui:searchQuery."@en .

elody:RelationSelectEditor a elody:Editor ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "relation select (single)"@en ; elody:fallbackWidget shui:InstancesSelectEditor ;
  rdfs:comment "Dropdown over the instances of a related entity type, stored as an Elody relation."@en .

elody:RelationMultiSelectEditor a elody:Editor ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "relation select (multiple)"@en ; elody:fallbackWidget shui:InstancesSelectEditor ;
  rdfs:comment "Multi-select over the instances of a related entity type, stored as Elody relations (sh:maxCount absent or > 1)."@en .

elody:MetadataSelectEditor a elody:Editor ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "metadata select (single)"@en ; elody:fallbackWidget shui:EnumSelectEditor ;
  rdfs:comment "Dropdown whose options come from a metadata key's known values rather than sh:in."@en .

elody:MetadataMultiSelectEditor a elody:Editor ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "metadata select (multiple)"@en ; elody:fallbackWidget shui:EnumSelectEditor ;
  rdfs:comment "Multi-select variant of elody:MetadataSelectEditor."@en .

elody:RadioEditor a elody:Editor ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "radio buttons"@en ; elody:fallbackWidget shui:EnumSelectEditor ;
  rdfs:comment "sh:in rendered as radio buttons (short enumerations)."@en .

elody:RangeEditor a elody:Editor ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "range slider"@en ; elody:fallbackWidget shui:NumberFieldEditor ;
  rdfs:comment "Number within sh:minInclusive/sh:maxInclusive as a slider."@en .

elody:ColorEditor a elody:Editor ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "colour picker"@en ; elody:fallbackWidget shui:TextFieldEditor ;
  rdfs:comment "A colour value as a picker; the stored literal is the CSS colour string."@en .

elody:ResizableTextAreaEditor a elody:Editor ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "resizable text area"@en ; elody:fallbackWidget shui:TextAreaEditor ;
  rdfs:comment "Text area the user can resize."@en .

elody:FileUploadEditor a elody:Editor ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "file upload"@en ; elody:fallbackWidget shui:Editor ;
  rdfs:comment "Upload one or more files into Elody mediafiles. No standard editor: shui edits RDF terms, not binary uploads."@en .

elody:CsvUploadEditor a elody:Editor ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "CSV upload"@en ; elody:fallbackWidget elody:FileUploadEditor ;
  rdfs:comment "Upload a CSV the platform imports."@en .

elody:XmlUploadEditor a elody:Editor ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "XML upload"@en ; elody:fallbackWidget elody:FileUploadEditor ;
  rdfs:comment "Upload an XML file the platform imports."@en .

elody:FileSystemImportEditor a elody:Editor ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "file system import"@en ; elody:fallbackWidget elody:FileUploadEditor ;
  rdfs:comment "Import from a server-side folder (filesystem importer service)."@en .

# -- the standard viewers --------------------------------------------------------
# Which shui: viewers Elody implements is in the implementation bindings.
# shui:HTMLViewer and shui:ValueTableViewer are elements in the detail panel
# (elody:WysiwygElement, elody:ListElement). Not implemented: shui:ImageViewer (only
# for Elody mediafiles, see elody:MediafilePreviewViewer).

# -- Elody viewers -------------------------------------------------------------
elody:PillViewer a elody:Viewer ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "pill"@en ; elody:fallbackWidget shui:LiteralViewer ;
  rdfs:comment "The value as a coloured pill; elody:viewerArgument selects the colour scheme (\"auto\")."@en .

elody:LinkViewer a elody:Viewer ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "link"@en ; elody:fallbackWidget shui:HyperlinkViewer ;
  rdfs:comment "The value as a clickable link (Elody LinkFormatter)."@en .

elody:RegexpMatchViewer a elody:Viewer ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "regexp match"@en ; elody:fallbackWidget shui:LiteralViewer ;
  rdfs:comment "Shows only the part of the value matching elody:viewerArgument (a regular expression)."@en .

elody:MediafilePreviewViewer a elody:Viewer ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "mediafile preview"@en ; elody:fallbackWidget shui:ImageViewer ;
  rdfs:comment "Renders the referenced Elody mediafile as a preview (image, audio, video). Not implemented as a field formatter yet (no CustomFormatterTypes value): reserved term, rejected by the meta-shapes."@en .

elody:MarkdownViewer a elody:Viewer ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "markdown"@en ; elody:fallbackWidget shui:HTMLViewer ;
  rdfs:comment "Renders the literal as Markdown. Elody renders Markdown only as a detail element (elody:MarkdownElement), not as a field formatter: reserved term, rejected by the meta-shapes."@en .

elody:viewerArgument a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "viewer argument"@en ;
  rdfs:domain sh:PropertyShape ; rdfs:range xsd:string ;
  rdfs:comment "A parameter for the chosen shui:viewer (pill colour scheme, regular expression). No standard term: shui viewers take no parameters."@en .

# =============================================================================
# 3. Structural classes
# =============================================================================

elody:EntityUi a owl:Class ; rdfs:subClassOf sh:NodeShape ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "entity UI"@en ;
  rdfs:comment "The UI of one Elody entity type. It is a sh:NodeShape (R1): its sh:property shapes are the one list of fields that drives the listing card, the detail panels, the sort options and the forms. sh:targetClass anchors it to the domain ontology. No standard term: shui describes forms, not listings and detail pages."@en .

elody:ListingUi a owl:Class ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "listing UI"@en ;
  rdfs:comment "A listing over several entity families at once (e.g. a WEMI overview), with its own query names and view modes. No standard term."@en .

elody:EntityFamily a owl:Class ; rdfs:subClassOf sh:NodeShape ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "entity family"@en ;
  rdfs:comment "One card fragment shared by several GraphQL types inside a listing, anchored to its domain class through sh:targetClass."@en .

elody:ViewModeSelection a owl:Class ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "view mode selection"@en ;
  rdfs:comment "One allowed view mode of a listing, with its order and configuration entries."@en .

elody:ViewMode a owl:Class ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "view mode"@en ;
  rdfs:comment "Enumeration of the ways Elody can render a listing."@en .
elody:ListView     a elody:ViewMode ; rdfs:label "list"@en ;     rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:GridView     a elody:ViewMode ; rdfs:label "grid"@en ;     rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:MapView      a elody:ViewMode ; rdfs:label "map"@en ;      rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:MediaView    a elody:ViewMode ; rdfs:label "media"@en ;    rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:PipelineView a elody:ViewMode ; rdfs:label "pipeline"@en ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:CalendarView a elody:ViewMode ; rdfs:label "calendar"@en ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:comment "Ahead of master: the enum value lives on branch feat/calendar-view-mode (#166680)."@en .
elody:TableView    a elody:ViewMode ; rdfs:label "table"@en ;    rdfs:isDefinedBy <https://elody.eu/ns/ui> .

elody:ConfigEntry a owl:Class ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "configuration entry"@en ;
  rdfs:comment "A key/value pair passed to a view mode (multiLine, multiLineColumns, edgeRelations, ...)."@en .

elody:Filter a owl:Class ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "filter"@en ;
  rdfs:comment "An advanced filter offered on a listing or a picker: its kind, the key it filters on, defaults and visibility. No standard term: shui:searchQuery is SPARQL, Elody filters the document store."@en .

elody:FilterKind a owl:Class ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "filter kind"@en ;
  rdfs:comment "Enumeration of Elody advanced filter types."@en .
elody:TextFilter      a elody:FilterKind ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:DateFilter      a elody:FilterKind ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:NumberFilter    a elody:FilterKind ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:SelectionFilter a elody:FilterKind ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:BooleanFilter   a elody:FilterKind ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:TypeFilter      a elody:FilterKind ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:IdFilter        a elody:FilterKind ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:GeoFilter       a elody:FilterKind ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:MetadataOnRelationFilter a elody:FilterKind ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> .

elody:ContextMenu a owl:Class ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "context menu"@en ;
  rdfs:comment "The per-card context menu: whether it is always shown, whether the platform's basic actions are included, and the client's own actions."@en .

elody:Action a owl:Class ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "context menu action"@en ;
  rdfs:comment "A platform action offered in a context menu. The declaration carries parameters (kind, form, label, icon); the behaviour lives in the platform."@en .

elody:ActionKind a owl:Class ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "action kind"@en ;
  rdfs:comment "Enumeration of the platform actions a context menu can trigger (ContextMenuElodyActionEnum)."@en .
elody:UpdateMetadataAction a elody:ActionKind ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:DeleteEntityAction   a elody:ActionKind ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:DeleteRelationAction a elody:ActionKind ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:ShareAction          a elody:ActionKind ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:EndpointCallAction   a elody:ActionKind ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:SetPrimaryThumbnailAction a elody:ActionKind ; rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:comment "A general action (doGeneralAction): make the entity the primary thumbnail."@en .
elody:SetPrimaryMediafileAction a elody:ActionKind ; rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:comment "A general action (doGeneralAction): make the entity the primary media file."@en .
elody:DownloadQueryResultAction a elody:ActionKind ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:CreateEntityFromExternalSourceAction a elody:ActionKind ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> .

elody:BulkOperation a owl:Class ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "bulk operation"@en ;
  rdfs:comment "An operation in the listing's action bar: kind, label, icon, permissions, the interaction context it is enabled in and the modal it opens."@en .

elody:BulkOperationKind a owl:Class ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "bulk operation kind"@en ;
  rdfs:comment "Enumeration of platform bulk operations (BulkOperationTypes)."@en .
elody:CreateEntityOperation     a elody:BulkOperationKind ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:AddRelationOperation      a elody:BulkOperationKind ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:DeleteEntitiesOperation   a elody:BulkOperationKind ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:DeleteRelationsOperation  a elody:BulkOperationKind ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:EditOperation             a elody:BulkOperationKind ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:ExportCsvOperation        a elody:BulkOperationKind ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:DownloadMediafilesDirectlyOperation a elody:BulkOperationKind ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:ExportXlsxOperation a elody:BulkOperationKind ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:ExportCsvOfMediafilesOperation a elody:BulkOperationKind ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:BulkUpdateMetadataOperation a elody:BulkOperationKind ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:MarkAsSeenOperation a elody:BulkOperationKind ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:MarkAsUnseenOperation a elody:BulkOperationKind ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:MergeEntitiesOperation a elody:BulkOperationKind ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:DownloadMediafilesOperation a elody:BulkOperationKind ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:ReorderEntitiesOperation  a elody:BulkOperationKind ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:StartOcrOperation         a elody:BulkOperationKind ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:OpenDropdownOperation     a elody:BulkOperationKind ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .

elody:BulkOperationContext a owl:Class ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "bulk operation context"@en ;
  rdfs:comment "When a bulk operation is enabled: the interaction mode, the selection state, and the tooltip explaining it."@en .

elody:InteractionMode a owl:Class ; rdfs:label "interaction mode"@en ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:comment "Enumeration: read or edit mode of a listing."@en .
elody:ReadMode a elody:InteractionMode ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:EditMode a elody:InteractionMode ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> .

elody:SelectionState a owl:Class ; rdfs:label "selection state"@en ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:comment "Enumeration: how many entities are selected."@en .
elody:NoneSelected a elody:SelectionState ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:SomeSelected a elody:SelectionState ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> .

elody:BulkOperationModal a owl:Class ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "bulk operation modal"@en ;
  rdfs:comment "The modal a bulk operation opens: its kind, the form it loads, the relation it creates, and the permission it needs."@en .

elody:ModalKind a owl:Class ; rdfs:label "modal kind"@en ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:comment "Enumeration of platform modals (TypeModals)."@en .
elody:DynamicFormModal      a elody:ModalKind ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:DeleteEntitiesModal   a elody:ModalKind ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:DeleteRelationsModal  a elody:ModalKind ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:BulkEditModal         a elody:ModalKind ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:ConfirmModal          a elody:ModalKind ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:DeleteModal           a elody:ModalKind ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:EntityDetailModal     a elody:ModalKind ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:EntityEditModal       a elody:ModalKind ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:BulkOperationsModal   a elody:ModalKind ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:GuidedFlowModal       a elody:ModalKind ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:MergeModal            a elody:ModalKind ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .

elody:Permission a owl:Class ; rdfs:label "permission"@en ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:comment "Enumeration of the generic platform permissions a modal may require."@en .
elody:CanCreate a elody:Permission ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:CanRead   a elody:Permission ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:CanUpdate a elody:Permission ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:CanDelete a elody:Permission ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> .

elody:CustomBulkOperations a owl:Class ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "custom bulk operations"@en ;
  rdfs:comment "A named set of bulk operations a list element loads on demand (an embedded relation list has its own action bar)."@en .

elody:Form a owl:Class ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "form"@en ;
  rdfs:comment "A create/edit form: the node shape whose property shapes are its fields (elody:shape), a label and a submit action. The field widgets come from shui:editor / sh:datatype / sh:class on those property shapes; nothing is repeated here (R1)."@en .

elody:SubmitAction a owl:Class ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "submit action"@en ;
  rdfs:comment "What a form's submit button does: label, icon, the platform mutation and the entity type it creates."@en .
elody:showsFormErrors a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "shows form errors"@en ; rdfs:domain elody:SubmitAction ; rdfs:range xsd:boolean ;
  rdfs:comment "Show the form's validation errors when the submit is refused (showsFormErrors). Default false."@en .
elody:Thumbnail a owl:Class ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "thumbnail"@en ;
  rdfs:comment "The picture on the card: read from an initial value (elody:key, e.g. the display filename read as \"thumbnail\") or from the entity's primary media file (elody:fromMediafile true)."@en .
elody:thumbnail a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "card thumbnail"@en ; rdfs:domain elody:EntityUi ; rdfs:range elody:Thumbnail ;
  rdfs:comment "The card shows a thumbnail (teaserMetadata.thumbnail), before the fields."@en .
elody:fromMediafile a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "from media file"@en ; rdfs:domain elody:Thumbnail ; rdfs:range xsd:boolean ;
  rdfs:comment "The thumbnail is the entity's primary media file (filename(fromMediafile: true))."@en .

elody:GuidedFlow a owl:Class ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "guided flow"@en ;
  rdfs:comment "A multi-step form (stepper) that creates or picks entities and attaches them to the host entity (Elody RepetitiveForm)."@en .

elody:FlowStep a owl:Class ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "flow step"@en ;
  rdfs:comment "One step of a guided flow: which entity type, which form or picker, how many may be selected, and the overview fields."@en .

elody:OverviewField a owl:Class ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "overview field"@en ;
  rdfs:comment "A field shown in a flow step's overview of what was created or picked."@en .

elody:Finalize a owl:Class ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "finalize"@en ;
  rdfs:comment "How a guided flow attaches its result to the host entity: from which step, with which relation type."@en .

elody:Picker a owl:Class ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "entity picker"@en ;
  rdfs:comment "A pick-from-listing modal: the result fragments per type and the scoping filters. The generator derives both its documents' names from the node."@en .

elody:ListQuery a owl:Class ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "list query"@en ;
  rdfs:comment "The entities document a list element loads, with its filters document: the result fragment per type (without results the entities document stays hand-written and only the filters document is generated) and the scoping filters (the type, the relation to the entity shown). Named by elody:queryName; the filters document by elody:filtersQuery, else the query name with Filters."@en .
elody:listQuery a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "list query"@en ; rdfs:domain owl:Thing ; rdfs:range elody:ListQuery ;
  rdfs:comment "The declared entities and filters documents the list loads; sets customQuery and customQueryFilters. On an EntityUi: list queries the type's documents name without a list element (the documents of the delete flow), and the type's orphan documents, an entities or filters document nothing references but the client keeps; a filters document alone names only elody:filtersQuery."@en .
elody:PickerResult a owl:Class ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "picker result"@en ;
  rdfs:comment "One GraphQL type a picker may return, with the card fragment that renders it."@en .

elody:DetailLayout a owl:Class ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "detail layout"@en ;
  rdfs:comment "The detail page of an entity: columns of elements. No standard term: shui describes a form, not a page layout."@en .

elody:Column a owl:Class ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "column"@en ;
  rdfs:comment "A column of the detail page with its width and ordered elements."@en .

elody:ColumnSize a owl:Class ; rdfs:label "column size"@en ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:comment "Enumeration of column widths in percent (ColumnSizes)."@en .
elody:Width10  a elody:ColumnSize ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:Width20  a elody:ColumnSize ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:Width30  a elody:ColumnSize ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:Width40  a elody:ColumnSize ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:Width50  a elody:ColumnSize ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:Width60  a elody:ColumnSize ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:Width70  a elody:ColumnSize ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:Width80  a elody:ColumnSize ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:Width90  a elody:ColumnSize ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:Width100 a elody:ColumnSize ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> .

elody:Element a owl:Class ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "detail element"@en ;
  rdfs:comment "A block on the detail page. Subclasses say which kind."@en .
elody:WindowElement a owl:Class ; rdfs:subClassOf elody:Element ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "window element"@en ;
  rdfs:comment "A window holding metadata/relation panels."@en .
elody:ListElement a owl:Class ; rdfs:subClassOf elody:Element ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "list element"@en ;
  rdfs:comment "An embedded listing of related entities, with its own query, filters, bulk operations and picker."@en .
elody:ShaclShapeElement a owl:Class ; rdfs:subClassOf elody:Element ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "shape element"@en ;
  rdfs:comment "A read-only panel whose fields are derived at runtime from a SHACL shape (the entity's shapeFields)."@en .
elody:MarkdownElement a owl:Class ; rdfs:subClassOf elody:Element ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "markdown element"@en ;
  rdfs:comment "Renders one metadata value as Markdown."@en .

elody:Panel a owl:Class ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "panel"@en ;
  rdfs:comment "A panel inside a window element: its kind, collapsed state, editability and the fields it shows (references to the EntityUi's property shapes by sh:path)."@en .

elody:PanelKind a owl:Class ; rdfs:label "panel kind"@en ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:comment "Enumeration of panel types (PanelType)."@en .
elody:MetadataPanel  a elody:PanelKind ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:RelationPanel  a elody:PanelKind ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:MediainfoPanel a elody:PanelKind ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:MapPanel       a elody:PanelKind ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:BulkDataPanel  a elody:PanelKind ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .

elody:FormSource a owl:Class ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "form source document"@en ;
  rdfs:comment "An id-addressed GraphQL document a modal loads by name; the resolver answers with a runtime-derived form or report (processor config forms, pipeline validation)."@en .

elody:SearchInputKind a owl:Class ; rdfs:label "search input kind"@en ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:comment "Enumeration of the search bar variants of a list element (SearchInputType)."@en .
elody:AdvancedSearchInput   a elody:SearchInputKind ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:SimpleSearchInput     a elody:SearchInputKind ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:SavedSearchInput      a elody:SearchInputKind ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:AdvancedMediaFilesSearchInput a elody:SearchInputKind ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .

elody:SortDirection a owl:Class ; rdfs:label "sort direction"@en ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:comment "Enumeration: ascending or descending."@en .
elody:Ascending  a elody:SortDirection ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:Descending a elody:SortDirection ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> .

elody:Unit a owl:Class ; rdfs:label "display unit"@en ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:comment "Enumeration of value display formats (Unit)."@en .
elody:DatetimeDefault a elody:Unit ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:DatetimeDmy24   a elody:Unit ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:DatetimeDmy12   a elody:Unit ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:DatetimeMdy24   a elody:Unit ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:DatetimeMdy12   a elody:Unit ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:DateDefault     a elody:Unit ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:SecondsDefault  a elody:Unit ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:ListDefault     a elody:Unit ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:CoordinatesDefault a elody:Unit ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:Percent a elody:Unit ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:Pixels  a elody:Unit ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:Html    a elody:Unit ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:Volt    a elody:Unit ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:Image   a elody:Unit ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .

elody:ValueSource a owl:Class ; rdfs:label "value source"@en ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:comment "Enumeration of where a card field's value is read from (KeyValueSource)."@en .
elody:MetadataSource      a elody:ValueSource ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:RelationsSource     a elody:ValueSource ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:RootSource          a elody:ValueSource ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:TypePillLabelSource a elody:ValueSource ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:TechnicalMetadataSource a elody:ValueSource ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:RelationMetadataSource  a elody:ValueSource ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:RepeatableMetadataSource a elody:ValueSource ; rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:comment "A value read from a repeatable metadata group (source: repeatableMetadata), the group's key in elody:repeatableMetadataKey."@en .
elody:ParentRootSource a elody:ValueSource ; rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:comment "A root field of the parent entity (source: parentRoot), reached over the relation in elody:parentRelationType."@en .
elody:ParentMetadataSource a elody:ValueSource ; rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:comment "A metadata value of the parent entity (source: parentMetadata), reached over elody:parentRelationType or over elody:parentEntityType and elody:parentKey."@en .
elody:ParentRelationsSource a elody:ValueSource ; rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:comment "A relation of the parent entity (source: parentRelations), the parent reached over elody:parentRelationType."@en .
elody:RelationRootdataSource a elody:ValueSource ; rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:comment "A root field of the relation itself (source: relationRootdata), the relation named in elody:relationKey."@en .

# =============================================================================
# 4. Properties — generator directives
# =============================================================================

elody:graphqlType a owl:DatatypeProperty ; elody:directive true ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "GraphQL type"@en ;
  rdfs:domain owl:Thing ; rdfs:range xsd:string ;
  rdfs:comment "The GraphQL object type this UI (or picker result) is rendered for. Directive: it will be derived from sh:targetClass through the application profile's class-to-type register."@en .

elody:graphqlTypes a owl:ObjectProperty ; elody:directive true ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "GraphQL types"@en ;
  rdfs:domain elody:EntityFamily ; rdfs:range rdf:List ;
  rdfs:comment "The GraphQL object types sharing one family fragment, as an RDF list. Directive, same fate as elody:graphqlType."@en .

elody:documentName a owl:DatatypeProperty ; elody:directive true ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "document name"@en ;
  rdfs:domain elody:EntityUi ; rdfs:range xsd:string ;
  rdfs:comment "Base name of the generated fragments and documents (minimal<Name>, full<Name>, <name>.queries.ts). Defaults to elody:graphqlType; needed when several declarations render the same GraphQL type, such as a showcase on BaseEntity."@en .

elody:emit a owl:DatatypeProperty ; elody:directive true ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "emit mode"@en ;
  rdfs:domain elody:EntityUi ; rdfs:range xsd:string ;
  rdfs:comment "\"file\": the whole query document is generated; \"regions\": generated blocks are spliced between markers in a hand-written file. Absent declaration = hand-written GraphQL. This is the per-entity ttl / both / graphql switch."@en .

elody:documents a owl:DatatypeProperty ; elody:directive true ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "standard documents"@en ;
  rdfs:domain elody:EntityUi ; rdfs:range xsd:string ;
  rdfs:comment "Which standard documents to emit for the type: entities, filters, sortOptions, bulkOperations, and currentUser (the getElodyUser document reading the signed-in user as this type). Directive: derivable from what the declaration contains."@en .

elody:fragment a owl:DatatypeProperty ; elody:directive true ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "fragment name"@en ;
  rdfs:domain owl:Thing ; rdfs:range xsd:string ;
  rdfs:comment "The name of a GraphQL fragment (a family's card, a picker result). Directive: derivable from the node."@en .

elody:queryName a owl:DatatypeProperty ; elody:directive true ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "query name"@en ;
  rdfs:domain owl:Thing ; rdfs:range xsd:string ;
  rdfs:comment "The GraphQL operation name of a form, flow, picker, custom bulk operation set or form source. Optional: the generator derives it from the node's local name when absent (R3)."@en .

elody:entitiesQuery a owl:DatatypeProperty ; elody:directive true ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "entities query name"@en ; rdfs:domain elody:ListingUi ; rdfs:range xsd:string ;
  rdfs:comment "Operation name of a listing's entities document."@en .
elody:entitiesField a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "entities resolver field"@en ; rdfs:domain elody:ListingUi ; rdfs:range xsd:string ;
  rdfs:comment "The resolver field a listing reads instead of the standard Entities field."@en .
elody:filtersQuery a owl:DatatypeProperty ; elody:directive true ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "filters query name"@en ; rdfs:domain owl:Thing ; rdfs:range xsd:string ;
  rdfs:comment "Operation name of a listing's, a picker's or a list query's filters document, when it is not the query name with Filters."@en .
elody:rootFilter a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "root filter key"@en ; rdfs:domain elody:ListingUi ; rdfs:range xsd:string ;
  rdfs:comment "The hidden selection filter whose empty value resolves to the host entity ids."@en .
elody:family a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "family"@en ; rdfs:domain elody:ListingUi ; rdfs:range elody:EntityFamily ;
  rdfs:comment "An entity family shown in the listing."@en .

# =============================================================================
# 5. Properties — the entity UI
# =============================================================================

elody:typePills a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "type pills"@en ; rdfs:domain elody:EntityUi ; rdfs:range xsd:boolean ;
  rdfs:comment "Show the platform's type pill on the card."@en .
elody:relationValues a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "reads relation values"@en ; rdfs:domain elody:EntityUi ; rdfs:range xsd:boolean ;
  rdfs:comment "Whether the type's fragments read its relations (relationValues). Default: yes when a property reads a relation, a panel lists related entities or the card has a context menu; no otherwise. true or false overrides the default."@en .
elody:listingValuesSpread a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "listing values spread"@en ; rdfs:domain elody:EntityUi ; rdfs:range xsd:string ;
  rdfs:comment "A hand-written fragment on IntialValues spread into the listing fragment's initial values (...vocabTeaserIntialValues): fields several types share."@en .
elody:detailValuesSpread a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "detail values spread"@en ; rdfs:domain elody:EntityUi ; rdfs:range xsd:string ;
  rdfs:comment "A hand-written fragment on IntialValues spread into the detail fragment's initial values (...entityAuditIntialValues)."@en .
elody:cardSpread a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "card spread"@en ; rdfs:domain elody:EntityUi ; rdfs:range xsd:string ;
  rdfs:comment "A hand-written fragment on teaserMetadata spread into the card (...vocabTeaserMetadata)."@en .
elody:filtersSpread a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "filters spread"@en ; rdfs:domain elody:EntityUi ; rdfs:range xsd:string ;
  rdfs:comment "A hand-written fragment on AdvancedFilters spread into the type's filters (...entityAuditFilters)."@en .
elody:spread a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "spread"@en ; rdfs:domain owl:Thing ; rdfs:range xsd:string ;
  rdfs:comment "A hand-written fragment on WindowElementPanel spread into the panel, after its fields (...entityAuditMetadata)."@en .
elody:detailFormatters a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "formatters on the detail page"@en ; rdfs:domain elody:EntityUi ; rdfs:range xsd:boolean ;
  rdfs:comment "Whether the detail fragment reads values with their viewer's formatter too (formatter: \"pill\"), as the listing does. Default true; false reads the raw values on the detail page."@en .
elody:filtersFragmentName a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "filters fragment name"@en ; rdfs:domain elody:EntityUi ; rdfs:range xsd:string ;
  rdfs:comment "The name of the type's filters fragment when it is not filtersFor<Type> (a client that names them <type>Filters)."@en .
elody:excludeBaseSortOptions a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "exclude base sort options"@en ; rdfs:domain elody:EntityUi ; rdfs:range xsd:boolean ;
  rdfs:comment "The listing offers only the declared sort options, not the platform's (excludeBaseSortOptions)."@en .
elody:bulkOperations a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "carries bulk operations"@en ; rdfs:domain elody:EntityUi ; rdfs:range xsd:boolean ;
  rdfs:comment "Whether the type carries a bulk operations fragment. Default: yes when an elody:bulkOperation is declared or elody:documents names bulkOperations; no otherwise. true emits the fragment even without operations (the type offers none), false suppresses it."@en .

elody:dynamicFormConfig a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "dynamic form config field"@en ; rdfs:domain elody:EntityUi ; rdfs:range xsd:string ;
  rdfs:comment "The resolver field carrying runtime-computed form panels for this type (read as the generic dynamicFormConfig)."@en .

elody:ports a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "ports field"@en ; rdfs:domain elody:EntityUi ; rdfs:range xsd:string ;
  rdfs:comment "The resolver field carrying the typed ports the pipeline view wires."@en .

elody:viewMode a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "view mode"@en ; rdfs:domain owl:Thing ; rdfs:range elody:ViewModeSelection ;
  rdfs:comment "An allowed view mode of the listing (EntityUi or ListingUi)."@en .
elody:mode a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "mode"@en ; rdfs:domain elody:ViewModeSelection ; rdfs:range elody:ViewMode ;
  rdfs:comment "Which view mode. Range changed in 0.1: an elody:ViewMode instance, no longer the enum string."@en .
elody:config a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "config"@en ; rdfs:domain owl:Thing ; rdfs:range elody:ConfigEntry ;
  rdfs:comment "A configuration entry of a view mode or a map element."@en .
elody:key a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "key"@en ; rdfs:domain owl:Thing ; rdfs:range xsd:string ;
  rdfs:comment "A platform key: a config entry's name, a filter's document key, a step's key, a card field's value key when it differs from sh:name."@en .
elody:value a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "value"@en ; rdfs:domain owl:Thing ; rdfs:range rdfs:Literal ;
  rdfs:comment "A config entry's value: string, number, boolean, an RDF list of strings, a node holding elody:config entries (an object value), or an elody: enumeration instance (rendered as its enum value, e.g. elody:WktMap). On an elody:FilterOption: the option's value."@en .
elody:edgeRelations a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "edge relations"@en ; rdfs:domain elody:ViewModeSelection ; rdfs:range rdf:List ;
  rdfs:comment "For the pipeline view: the relation types rendered as edges, as an RDF list. Equivalent to the config entry \"edgeRelations\"."@en .

# -- property shape presentation facts (the card and the panels) ----------------
elody:teaser a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "on the card"@en ; rdfs:domain sh:PropertyShape ; rdfs:range xsd:boolean ;
  rdfs:comment "false keeps the field off the listing card (it stays in the fragment for the panels). Default true. dash:hidden is not the same: hidden fields are not shown anywhere."@en .
elody:detailOnly a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "detail only"@en ; rdfs:domain sh:PropertyShape ; rdfs:range xsd:boolean ;
  rdfs:comment "true reads the field on the detail page only: it is left out of the listing fragment's initial values, and off the card. Default false: a field is read in the listing and on the detail page."@en .
elody:listingOnly a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "listing only"@en ; rdfs:domain sh:PropertyShape ; rdfs:range xsd:boolean ;
  rdfs:comment "true reads the field in the listing fragment only, not on the detail page (a card thumbnail, a size). Default false."@en .
elody:readsValue a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "reads value"@en ; rdfs:domain sh:PropertyShape ; rdfs:range xsd:boolean ;
  rdfs:comment "false reads no initial value for the field: a spread fragment or the platform provides it, the declaration only shows or sorts it (a panel field of a shared vocabulary fragment, a sort option on a key the fragments do not read). Default true."@en .
elody:valueLabelRootKey a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "value label root key"@en ; rdfs:domain sh:PropertyShape ; rdfs:range xsd:string ;
  rdfs:comment "A relation-valued property labels the related entity by this root field (rootKeyAsLabel: \"display_filename\") instead of a metadata key."@en .
elody:sortLabelKey a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "sort label key"@en ; rdfs:domain sh:PropertyShape ; rdfs:range xsd:string ;
  rdfs:comment "The translation key of the field's sort option when it differs from the field's label (elody:labelKey)."@en .
elody:sortOrder a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "sort order"@en ; rdfs:domain sh:PropertyShape ; rdfs:range xsd:integer ;
  rdfs:comment "The position of the field among the listing's sort options when it differs from sh:order."@en .
elody:clientInputField a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "client input field"@en ; rdfs:domain [ a owl:Class ; owl:unionOf ( sh:PropertyShape elody:CreateField ) ] ; rdfs:range xsd:string ;
  rdfs:comment "The input field the client registers itself under this name (customInputFields; inputField(type: keywordTypeField)) for editing this property; the generator uses the name and mints no field. Prefer sh:class, sh:in or an editor, which generate the field."@en .
elody:colSpan a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "column span"@en ; rdfs:domain sh:PropertyShape ; rdfs:range xsd:integer ;
  rdfs:comment "How many card columns the field spans in multi-line list mode."@en .
elody:unit a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "unit"@en ; rdfs:domain sh:PropertyShape ; rdfs:range elody:Unit ;
  rdfs:comment "Display format of the value (dates, percentages). Not sh:datatype: it is presentation, the stored literal is unchanged."@en .
elody:sortable a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "sortable"@en ; rdfs:domain sh:PropertyShape ; rdfs:range xsd:boolean ;
  rdfs:comment "Offer the field in the listing's sort options."@en .
elody:defaultSortDirection a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "default sort direction"@en ; rdfs:domain sh:PropertyShape ; rdfs:range elody:SortDirection ;
  rdfs:comment "The listing opens sorted on this field in this direction."@en .
elody:source a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "value source"@en ; rdfs:domain sh:PropertyShape ; rdfs:range elody:ValueSource ;
  rdfs:comment "Where the card reads the value (metadata by default)."@en .
elody:index a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "index"@en ; rdfs:domain sh:PropertyShape ; rdfs:range xsd:integer ;
  rdfs:comment "For list-valued sources: which element to show."@en .

# -- filters ---------------------------------------------------------------------
elody:filter a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "filter"@en ; rdfs:domain owl:Thing ; rdfs:range elody:Filter ;
  rdfs:comment "A filter of a listing (EntityUi) or a picker."@en .
elody:alias a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "alias"@en ; rdfs:domain owl:Thing ; rdfs:range xsd:string ;
  rdfs:comment "The GraphQL alias under which a filter (a filter without one is emitted unaliased), action, panel, element, form tab (on an elody:Form; default \"name\"), submit action (on an elody:submit node; default \"createAction\") or property is emitted. On a property shape: the field name the fragment reads the value under when it is not the metadata key (title: keyValue(key: \"email\")); several property shapes may share one sh:path under different aliases. Open string by design."@en .
elody:optionsType a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "options type"@en ; rdfs:domain elody:Filter ; rdfs:range xsd:string ;
  rdfs:comment "A selection filter offers the entities of this type as its options (advancedFilterInputForRetrievingOptions: a text search on elody:optionsKey, scoped to the type). Left out when the search is scoped by elody:optionsInput nodes alone."@en .
elody:optionsKey a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "options key"@en ; rdfs:domain elody:Filter ; rdfs:range xsd:string ;
  rdfs:comment "The key searched for the options of a selection filter (\"vliz:1|properties.title.value\")."@en .
elody:optionsMatchExact a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "options match exact"@en ; rdfs:domain elody:Filter ; rdfs:range xsd:boolean ;
  rdfs:comment "Whether the option search matches exactly (match_exact). Default false."@en .
elody:optionsDistinctBy a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "options distinct by"@en ; rdfs:domain elody:Filter ; rdfs:range xsd:string ;
  rdfs:comment "The key the option search is made distinct by (distinct_by)."@en .
elody:optionsLabel a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "options label"@en ; rdfs:domain elody:Filter ; rdfs:range xsd:string ;
  rdfs:comment "Where a selection filter's option takes its label from (filterOptionsMapping.label, e.g. \"intialValues.access\")."@en .
elody:optionsValue a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "options value"@en ; rdfs:domain elody:Filter ; rdfs:range xsd:string ;
  rdfs:comment "Where a selection filter's option takes its value from (filterOptionsMapping.value)."@en .
elody:selectionOption a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "selection option"@en ; rdfs:domain elody:Filter ; rdfs:range xsd:string ;
  rdfs:comment "How a selection filter offers its options (selectionOption: autocomplete, ...)."@en .
elody:matchersType a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "matchers type"@en ; rdfs:domain elody:Filter ; rdfs:range xsd:string ;
  rdfs:comment "Which matchers the filter offers (matchersType: selectionForMetadata, ...)."@en .
elody:Lookup a owl:Class ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "lookup"@en ;
  rdfs:comment "A join a filter needs: the collection looked up, the local and the foreign field, and the name the joined documents get (lookup: { from, local_field, foreign_field, as })."@en .
elody:lookup a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "lookup"@en ; rdfs:domain elody:Filter ; rdfs:range elody:Lookup ;
  rdfs:comment "The join the filter needs before it can match."@en .
elody:lookupFrom a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "lookup from"@en ; rdfs:domain elody:Lookup ; rdfs:range xsd:string ;
  rdfs:comment "The collection looked up."@en .
elody:lookupLocalField a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "lookup local field"@en ; rdfs:domain elody:Lookup ; rdfs:range xsd:string ;
  rdfs:comment "The field on this side of the join."@en .
elody:lookupForeignField a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "lookup foreign field"@en ; rdfs:domain elody:Lookup ; rdfs:range xsd:string ;
  rdfs:comment "The field on the looked-up side of the join."@en .
elody:lookupAs a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "lookup as"@en ; rdfs:domain elody:Lookup ; rdfs:range xsd:string ;
  rdfs:comment "The name the joined documents get."@en .
elody:showTime a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "show time"@en ; rdfs:domain elody:Filter ; rdfs:range xsd:boolean ;
  rdfs:comment "A date filter offers the time of day too (showTimeForDateFilter)."@en .
elody:filterOperator a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "filter operator"@en ; rdfs:domain elody:Filter ; rdfs:range xsd:string ;
  rdfs:comment "How the filter's values combine (operator: or, and)."@en .
elody:filterKind a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "filter kind"@en ; rdfs:domain elody:Filter ; rdfs:range elody:FilterKind ;
  rdfs:comment "Which advanced filter. Range changed in 0.1: an elody:FilterKind instance, no longer the string."@en .
elody:keyAsList a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "key as list"@en ; rdfs:domain elody:Filter ; rdfs:range xsd:boolean ;
  rdfs:comment "Emit the filter key as a one-element list (default true; the type selection filter needs a bare string)."@en .
elody:defaultValueAsList a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "default value as list"@en ; rdfs:domain elody:Filter ; rdfs:range xsd:boolean ;
  rdfs:comment "Emit the sh:defaultValue(s) as a list literal."@en .
elody:displayedByDefault a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "displayed by default"@en ; rdfs:domain elody:Filter ; rdfs:range xsd:boolean ;
  rdfs:comment "The filter is open when the listing loads."@en .
elody:showTooltip a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "show tooltip"@en ; rdfs:domain owl:Thing ; rdfs:range xsd:boolean ;
  rdfs:comment "Show the platform tooltip on a filter. Replaces the boolean use of the retired elody:tooltip; the tooltip text of a property is sh:description."@en .

# -- context menu and actions ----------------------------------------------------
elody:contextMenu a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "context menu"@en ; rdfs:domain [ a owl:Class ; owl:unionOf ( elody:EntityUi elody:WindowElement elody:ValuesFragment ) ] ; rdfs:range elody:ContextMenu ;
  rdfs:comment "The card's context menu; on an elody:WindowElement, the window's (contextMenuActions); on an elody:ValuesFragment, the menu of its card twin."@en .
elody:forceShow a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "force show"@en ; rdfs:domain elody:ContextMenu ; rdfs:range xsd:boolean ;
  rdfs:comment "Show the menu even when it would be empty by platform rules."@en .
elody:includeBasicActions a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "include basic actions"@en ; rdfs:domain elody:ContextMenu ; rdfs:range xsd:boolean ;
  rdfs:comment "Include the platform's basic actions (edit, delete, share)."@en .
elody:action a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "action"@en ; rdfs:domain elody:ContextMenu ; rdfs:range elody:Action ;
  rdfs:comment "An action of the menu."@en .
elody:actionKind a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "action kind"@en ; rdfs:domain elody:Action ; rdfs:range elody:ActionKind ;
  rdfs:comment "Which platform action. Replaces the string elody:actionType."@en .
elody:form a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "form"@en ; rdfs:domain owl:Thing ; rdfs:range elody:Form ;
  rdfs:comment "The form an action, a modal or a flow step opens, as a node (R3): the generator derives the document name. Replaces the string references elody:formQuery and elody:createForm. An EntityUi lists its forms with the same property."@en .
elody:formSourceRef a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "form source"@en ; rdfs:domain owl:Thing ; rdfs:range elody:FormSource ;
  rdfs:comment "The runtime form source an action opens, as a node (processor config forms)."@en .
elody:formFlow a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "form flow"@en ; rdfs:domain elody:Action ; rdfs:range xsd:string ;
  rdfs:comment "The platform's ContextMenuFormFlow value (Update, ...). Open string: the enum is small and client-extended."@en .
elody:formTitle a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "form title"@en ; rdfs:domain elody:Action ; rdfs:range xsd:string ;
  rdfs:comment "Translation key of the modal title."@en .
elody:icon a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "icon"@en ; rdfs:domain owl:Thing ; rdfs:range xsd:string ;
  rdfs:comment "A DamsIcons name. Open string: the icon set is the platform's and grows."@en .

# -- bulk operations -------------------------------------------------------------
elody:bulkOperation a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "bulk operation"@en ; rdfs:domain elody:EntityUi ; rdfs:range elody:BulkOperation ;
  rdfs:comment "An operation in the listing's action bar."@en .
elody:customBulkOperations a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "custom bulk operations"@en ; rdfs:domain owl:Thing ; rdfs:range elody:CustomBulkOperations ;
  rdfs:comment "A named operation set (on an EntityUi: declares it; on a list element: uses it, as a node reference)."@en .
elody:operation a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "operation"@en ; rdfs:domain [ a owl:Class ; owl:unionOf ( elody:CustomBulkOperations elody:ActionsOnResult ) ] ; rdfs:range elody:BulkOperation ;
  rdfs:comment "An operation in a custom set, or offered on a list's result (elody:ActionsOnResult)."@en .
elody:operationKind a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "operation kind"@en ; rdfs:domain elody:BulkOperation ; rdfs:range elody:BulkOperationKind ;
  rdfs:comment "Which platform bulk operation. Replaces the string elody:value on bulk operations."@en .
elody:primary a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "primary"@en ; rdfs:domain [ a owl:Class ; owl:unionOf ( elody:BulkOperation elody:SortOption ) ] ; rdfs:range xsd:boolean ;
  rdfs:comment "Render as the primary button; on a sort option, the option selected by default."@en .
elody:can a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "required permission"@en ; rdfs:domain owl:Thing ; rdfs:range xsd:string ;
  rdfs:comment "A fine-grained permission string (\"update:pipeline:has-runner\"). On a bulk operation or a list element: the permissions it needs; on a panel: the permission editing it needs (can(input: \"update:feedback\")). Open string: permissions are client-defined."@en .
elody:context a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "context"@en ; rdfs:domain elody:BulkOperation ; rdfs:range elody:BulkOperationContext ;
  rdfs:comment "When the operation is enabled."@en .
elody:activeViewMode a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "active view mode"@en ; rdfs:domain elody:BulkOperationContext ; rdfs:range elody:InteractionMode ;
  rdfs:comment "Read or edit mode."@en .
elody:selection a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "selection"@en ; rdfs:domain elody:BulkOperationContext ; rdfs:range elody:SelectionState ;
  rdfs:comment "Required selection state."@en .
elody:tooltipLabel a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "tooltip label"@en ; rdfs:domain elody:BulkOperationContext ; rdfs:range xsd:string ;
  rdfs:comment "Translation key of the tooltip explaining why the operation is enabled or not. Replaces the string use of the retired elody:tooltip."@en .
elody:modal a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "modal"@en ; rdfs:domain elody:BulkOperation ; rdfs:range elody:BulkOperationModal ;
  rdfs:comment "The modal the operation opens."@en .
elody:modalKind a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "modal kind"@en ; rdfs:domain elody:BulkOperationModal ; rdfs:range elody:ModalKind ;
  rdfs:comment "Which platform modal. Replaces the string elody:typeModal."@en .
elody:formRelationType a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "form relation type"@en ; rdfs:domain elody:BulkOperationModal ; rdfs:range xsd:string ;
  rdfs:comment "The relation type under which the created entity is attached to the host."@en .
elody:closeConfirmation a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "ask close confirmation"@en ; rdfs:domain elody:BulkOperationModal ; rdfs:range xsd:boolean ;
  rdfs:comment "Ask before closing the modal with unsaved input."@en .
elody:permission a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "needed permission"@en ; rdfs:domain elody:BulkOperationModal ; rdfs:range elody:Permission ;
  rdfs:comment "The generic permission the modal requires."@en .

# -- forms (R1) ------------------------------------------------------------------
elody:shape a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "shape"@en ; rdfs:domain elody:Form ; rdfs:range sh:NodeShape ;
  rdfs:comment "The node shape whose property shapes are the form's fields, in sh:order. May be the EntityUi itself or a sub-shape."@en .
elody:submit a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "submit"@en ; rdfs:domain elody:Form ; rdfs:range elody:SubmitAction ;
  rdfs:comment "The form's submit action."@en .
elody:actionQuery a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "action query"@en ; rdfs:domain elody:SubmitAction ; rdfs:range xsd:string ;
  rdfs:comment "The platform mutation document the submit calls (CreateEntity, ...)."@en .
elody:creationType a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "creation type"@en ; rdfs:domain elody:SubmitAction ; rdfs:range xsd:string ;
  rdfs:comment "The Elody entity type created (Entitytyping value). Open string: client-defined."@en .

# -- guided flows ----------------------------------------------------------------
elody:guidedFlow a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "guided flow"@en ; rdfs:domain elody:EntityUi ; rdfs:range elody:GuidedFlow ;
  rdfs:comment "A stepper flow declared for the type. Replaces elody:repetitiveForm."@en .
elody:repeatable a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "repeatable"@en ; rdfs:domain elody:GuidedFlow ; rdfs:range xsd:boolean ;
  rdfs:comment "Offer \"add another\" after the last step."@en .
elody:refetchOnFinish a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "refetch on finish"@en ; rdfs:domain elody:GuidedFlow ; rdfs:range xsd:boolean ;
  rdfs:comment "Reload the host entity when the flow closes."@en .
elody:step a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "step"@en ; rdfs:domain elody:GuidedFlow ; rdfs:range elody:FlowStep ;
  rdfs:comment "A step of the flow."@en .
elody:entityType a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "entity type"@en ; rdfs:domain [ a owl:Class ; owl:unionOf ( elody:FlowStep elody:Taggable ) ] ; rdfs:range xsd:string ;
  rdfs:comment "The Elody entity type the step creates or picks; on a taggable, the type tagged."@en .
elody:picker a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "picker"@en ; rdfs:domain owl:Thing ; rdfs:range elody:Picker ;
  rdfs:comment "A picker, as a node (R3): on an EntityUi it is declared; on a flow step or list element it is used. Replaces the string pairs pickerQuery/pickerFiltersQuery and pickerList/pickerFilters."@en .
elody:acceptedTypes a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "accepted types"@en ; rdfs:domain elody:FlowStep ; rdfs:range xsd:string ;
  rdfs:comment "Entity types the step accepts from the picker."@en .
elody:maxSelection a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "max selection"@en ; rdfs:domain elody:FlowStep ; rdfs:range xsd:integer ;
  rdfs:comment "How many entities the step may pick."@en .
elody:overviewField a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "overview field"@en ; rdfs:domain elody:FlowStep ; rdfs:range elody:OverviewField ;
  rdfs:comment "A field in the step's overview."@en .
elody:finalize a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "finalize"@en ; rdfs:domain elody:GuidedFlow ; rdfs:range elody:Finalize ;
  rdfs:comment "How the flow attaches its result to the host."@en .
elody:fromStep a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "from step"@en ; rdfs:domain [ a owl:Class ; owl:unionOf ( elody:Finalize elody:StepScope ) ] ; rdfs:range xsd:string ;
  rdfs:comment "The key of the step whose result is attached (on elody:Finalize) or whose relation scopes the search (on elody:StepScope, GraphQL step)."@en .
elody:relationType a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "relation type"@en ; rdfs:domain owl:Thing ; rdfs:range xsd:string ;
  rdfs:comment "An Elody relation type name (hasProcessor, isRunnerFor). Open string: client-defined, convention has<X> / is<X>For. On a property shape it names the relation the property reads and writes; without it, sh:path ex:x with sh:class is has<X> and sh:path [ sh:inversePath ex:x ] is is<X>For, the mirror collection-api stores on the other entity."@en .
elody:valueLabelKey a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "value label key"@en ; rdfs:domain sh:PropertyShape ; rdfs:range xsd:string ;
  rdfs:comment "The metadata key(s) of a related entity that label it as a value of this property (alternatives separated by |). Elody's counterpart of the spec's label chain for value nodes; default title|name|label."@en .

# -- linked-data sources ---------------------------------------------------------
# A property whose values a SPARQL endpoint holds is a relation to resources of
# that source. collection-api reads them live (SPARQL_SOURCES, written by
# `elody-ui generate`); nothing is copied. shui:searchQuery and sh:in [ sh:select ]
# whose pattern lies in one SERVICE block, and a shui:SubClassEditor with
# elody:classSource, are spelled out in these terms when a declaration is read.

elody:SparqlSource a owl:Class ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "SPARQL source"@en ;
  rdfs:comment "A linked-data source read live through collection-api's SPARQL engine: its endpoint, the query naming its resources and the one finding them for a search term."@en .

elody:readsFrom a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "reads from"@en ; rdfs:domain elody:EntityUi ; rdfs:range elody:SparqlSource ;
  rdfs:comment "The source an entity UI's resources come from: its Elody type is a collection on that source, not in the database."@en .

elody:optionsFrom a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "options from"@en ; rdfs:domain sh:PropertyShape ; rdfs:range elody:EntityUi ;
  rdfs:comment "The values of this property are resources of that entity UI's source: a relation, chosen with a dropdown that searches the source for what is typed."@en .

elody:classSource a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "class source"@en ; rdfs:domain sh:PropertyShape ;
  rdfs:comment "The SPARQL endpoint a shui:SubClassEditor reads sh:rootClass and its subclasses from, live and searched by label, instead of the class tree in the graphs the generator is given."@en .

elody:endpoint a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "endpoint"@en ; rdfs:domain elody:SparqlSource ;
  rdfs:comment "The SPARQL endpoint queries are sent to."@en .

elody:selectQuery a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "select query"@en ; rdfs:domain elody:SparqlSource ; rdfs:range xsd:string ;
  rdfs:comment "A SELECT binding ?value: the source's resources, for a listing."@en .

elody:searchQuery a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "search query"@en ; rdfs:domain elody:SparqlSource ; rdfs:range xsd:string ;
  rdfs:comment "A SELECT binding ?value for what the user typed: $searchTerm and $uiLanguage are filled in as string literals, as for shui:searchQuery."@en .

elody:identifierEncoding a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "identifier encoding"@en ; rdfs:domain elody:SparqlSource ; rdfs:range xsd:string ;
  rdfs:comment "\"iri\": a resource's Elody identifier is its IRI, encoded; for sources whose IRIs share no prefix."@en .

# -- pickers ---------------------------------------------------------------------
elody:result a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "result"@en ; rdfs:domain elody:Picker ; rdfs:range elody:PickerResult ;
  rdfs:comment "A type the picker may return."@en .

# -- detail layout -----------------------------------------------------------------
elody:detail a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "detail"@en ; rdfs:domain elody:EntityUi ; rdfs:range elody:DetailLayout ;
  rdfs:comment "The detail page layout."@en .
elody:shapeDriven a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "shape driven"@en ; rdfs:domain elody:DetailLayout ; rdfs:range xsd:boolean ;
  rdfs:comment "The detail fragment asks for the runtime shapeFields (the fields come from a SHACL shape, not from this declaration)."@en .
elody:fragmentField a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "extra fragment field"@en ; rdfs:domain elody:DetailLayout ; rdfs:range xsd:string ;
  rdfs:comment "A resolver field added verbatim to the detail fragment (pipelineConnections). Escape hatch, open string."@en .
elody:column a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "column"@en ; rdfs:domain elody:DetailLayout ; rdfs:range elody:Column ;
  rdfs:comment "A column of the page."@en .
elody:size a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "size"@en ; rdfs:domain elody:Column ; rdfs:range elody:ColumnSize ;
  rdfs:comment "Column width; without it the column takes what the layout gives."@en .
elody:element a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "element"@en ; rdfs:domain owl:Thing ; rdfs:range elody:Element ;
  rdfs:comment "An element in the column; on an elody:Panel, a list element shown among the panel's fields (a panel holding a filtered list of related entities): its sh:order is its position among the panel's items, fields and elements together, counting from 1."@en .
elody:expandButton a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "expand button"@en ; rdfs:domain elody:WindowElement ; rdfs:range xsd:boolean ;
  rdfs:comment "Offer the expand-to-full-screen button."@en .
elody:editButton a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "edit button"@en ; rdfs:domain elody:WindowElement ; rdfs:range xsd:boolean ;
  rdfs:comment "The window offers the edit-metadata button (editMetadataButton)."@en .
elody:listViewMode a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "list view mode"@en ; rdfs:domain elody:ListElement ; rdfs:range xsd:string ;
  rdfs:comment "How the list shows its entities (viewMode(input: Library), ...)."@en .
elody:collapsed a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "collapsed"@en ; rdfs:domain owl:Thing ; rdfs:range xsd:boolean ;
  rdfs:comment "The element or panel starts collapsed."@en .
elody:multipleColumns a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "multiple columns"@en ; rdfs:domain owl:Thing ; rdfs:range xsd:boolean ;
  rdfs:comment "The panel (or property group) may lay its fields out in several columns (canBeMultipleColumns)."@en .
elody:showsUngrouped a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "shows ungrouped properties"@en ; rdfs:domain sh:PropertyGroup ; rdfs:range xsd:boolean ;
  rdfs:comment "This detail panel also shows the entity's properties that have no sh:group, after its own. Lets a page put ungrouped properties in a panel without giving them a group they do not have: a create form keeps them as plain fields."@en .
elody:fieldsKey a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "fields key"@en ; rdfs:domain elody:ShaclShapeElement ; rdfs:range xsd:string ;
  rdfs:comment "The entity field holding the runtime shape-derived fields (default shapeFields)."@en .
elody:metadataKey a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "metadata key"@en ; rdfs:domain elody:Element ; rdfs:range xsd:string ;
  rdfs:comment "The metadata key whose value the element renders or edits (markdown, wysiwyg, entity viewer)."@en .
elody:entityTypes a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "entity types"@en ; rdfs:domain elody:ListElement ; rdfs:range xsd:string ;
  rdfs:comment "The entity types the embedded list shows."@en .
elody:customQuery a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "custom query"@en ; rdfs:domain elody:Element ; rdfs:range xsd:string ;
  rdfs:comment "The entities document the list loads (GetEntities or a client document)."@en .
elody:customQueryFilters a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "custom query filters"@en ; rdfs:domain elody:ListElement ; rdfs:range xsd:string ;
  rdfs:comment "The filters document the list loads."@en .
elody:searchInput a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "search input"@en ; rdfs:domain elody:ListElement ; rdfs:range elody:SearchInputKind ;
  rdfs:comment "Which search bar the list shows. Replaces the string elody:searchInputType."@en .
elody:panel a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "panel"@en ; rdfs:domain elody:WindowElement ;
  rdfs:range [ owl:unionOf ( elody:Panel sh:PropertyGroup ) ] ;
  rdfs:comment "A panel in the window. Preferably a sh:PropertyGroup: its fields are then the property shapes whose sh:group is that group, in their own sh:order (SHACL 1.2 UI grouping). An elody:Panel with an explicit elody:field list remains for a panel whose order differs from the properties' sh:order."@en .

elody:labelKey a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "label translation key"@en ; rdfs:domain owl:Thing ; rdfs:range xsd:string ;
  rdfs:comment "The Elody translation key under which the label is shown. The label text itself is sh:name (property shapes) or rdfs:label (property groups), language-tagged; `generate` writes those texts into the client's translation bundles under this key. Without elody:labelKey the generator mints ui.<type>.<key>. No standard term: SHACL carries label texts, not an application's translation keys."@en .
elody:panelKind a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "panel kind"@en ; rdfs:domain elody:Panel ; rdfs:range elody:PanelKind ;
  rdfs:comment "Which panel type. Replaces the string elody:panelType."@en .
elody:field a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "field"@en ; rdfs:domain owl:Thing ; rdfs:range rdfs:Resource ;
  rdfs:comment "A field shown in a panel or an overview, referenced by the sh:path IRI of the EntityUi's property shape (R3). On a form source: the resolver field, as a string (see elody:formSourceField)."@en .

# -- form sources ------------------------------------------------------------------
elody:formSource a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "form source"@en ; rdfs:domain elody:EntityUi ; rdfs:range elody:FormSource ;
  rdfs:comment "An id-addressed runtime document declared for the type."@en .
elody:resolverField a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "resolver field"@en ; rdfs:domain elody:FormSource ; rdfs:range xsd:string ;
  rdfs:comment "The GraphQL field the document selects (ProcessorConfigForm). Replaces the string use of elody:field on form sources."@en .
elody:withParent a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "with parent"@en ; rdfs:domain elody:FormSource ; rdfs:range xsd:boolean ;
  rdfs:comment "The document also takes the host entity id."@en .

# =============================================================================
# 6. Retired terms (R5): accepted on read for one release, replaced on migrate
# =============================================================================

elody:hidden a owl:DeprecatedProperty ; owl:deprecated true ;
  rdfs:label "hidden (retired)"@en ; rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  dcterms:isReplacedBy dash:hidden ;
  rdfs:comment "Retired: use dash:hidden."@en .
elody:editable a owl:DeprecatedProperty ; owl:deprecated true ;
  rdfs:label "editable (retired)"@en ; rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  dcterms:isReplacedBy dash:readOnly ;
  rdfs:comment "Retired: use dash:readOnly (negated)."@en .
elody:required a owl:DeprecatedProperty ; owl:deprecated true ;
  rdfs:label "required (retired)"@en ; rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  dcterms:isReplacedBy sh:minCount ;
  rdfs:comment "Retired: use sh:minCount 1."@en .
elody:inputType a owl:DeprecatedProperty ; owl:deprecated true ;
  rdfs:label "input type (retired)"@en ; rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  dcterms:isReplacedBy shui:editor ;
  rdfs:comment "Retired: use sh:datatype / sh:class / sh:node (inferred widget) or an explicit shui:editor."@en .
elody:defaultValue a owl:DeprecatedProperty ; owl:deprecated true ;
  rdfs:label "default value (retired)"@en ; rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  dcterms:isReplacedBy sh:defaultValue ;
  rdfs:comment "Retired: use sh:defaultValue."@en .
elody:tooltip a owl:DeprecatedProperty ; owl:deprecated true ;
  rdfs:label "tooltip (retired)"@en ; rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  dcterms:isReplacedBy elody:showTooltip , elody:tooltipLabel , sh:description ;
  rdfs:comment "Retired: it meant three things. Boolean on a filter -> elody:showTooltip; text on a bulk operation context -> elody:tooltipLabel; a property's tooltip text -> sh:description."@en .
elody:formatter a owl:DeprecatedProperty ; owl:deprecated true ;
  rdfs:label "formatter (retired)"@en ; rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  dcterms:isReplacedBy shui:viewer ;
  rdfs:comment "Retired: use shui:viewer with an Elody viewer (and elody:viewerArgument for the part after the pipe)."@en .
elody:createForm a owl:DeprecatedProperty ; owl:deprecated true ;
  rdfs:label "create form (retired)"@en ; rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  dcterms:isReplacedBy elody:form ;
  rdfs:comment "Retired: declare an elody:Form (fields as property shapes under elody:shape) and reference it with elody:form."@en .
elody:formQuery a owl:DeprecatedProperty ; owl:deprecated true ;
  rdfs:label "form query (retired)"@en ; rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  dcterms:isReplacedBy elody:form ;
  rdfs:comment "Retired: reference the form node with elody:form (or the form source with elody:formSourceRef)."@en .
elody:actionType a owl:DeprecatedProperty ; owl:deprecated true ;
  rdfs:label "action type (retired)"@en ; rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  dcterms:isReplacedBy elody:actionKind ;
  rdfs:comment "Retired: use elody:actionKind with an elody:ActionKind instance."@en .
elody:typeModal a owl:DeprecatedProperty ; owl:deprecated true ;
  rdfs:label "type modal (retired)"@en ; rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  dcterms:isReplacedBy elody:modalKind ;
  rdfs:comment "Retired: use elody:modalKind with an elody:ModalKind instance."@en .
elody:panelType a owl:DeprecatedProperty ; owl:deprecated true ;
  rdfs:label "panel type (retired)"@en ; rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  dcterms:isReplacedBy elody:panelKind ;
  rdfs:comment "Retired: use elody:panelKind with an elody:PanelKind instance."@en .
elody:searchInputType a owl:DeprecatedProperty ; owl:deprecated true ;
  rdfs:label "search input type (retired)"@en ; rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  dcterms:isReplacedBy elody:searchInput ;
  rdfs:comment "Retired: use elody:searchInput with an elody:SearchInputKind instance."@en .
elody:repetitiveForm a owl:DeprecatedProperty ; owl:deprecated true ;
  rdfs:label "repetitive form (retired)"@en ; rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  dcterms:isReplacedBy elody:guidedFlow ;
  rdfs:comment "Retired: use elody:guidedFlow."@en .
elody:pickerQuery a owl:DeprecatedProperty ; owl:deprecated true ;
  rdfs:label "picker query (retired)"@en ; rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  dcterms:isReplacedBy elody:picker ;
  rdfs:comment "Retired: reference the picker node with elody:picker."@en .
elody:pickerFiltersQuery a owl:DeprecatedProperty ; owl:deprecated true ;
  rdfs:label "picker filters query (retired)"@en ; rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  dcterms:isReplacedBy elody:picker ;
  rdfs:comment "Retired: reference the picker node with elody:picker."@en .
elody:pickerList a owl:DeprecatedProperty ; owl:deprecated true ;
  rdfs:label "picker list (retired)"@en ; rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  dcterms:isReplacedBy elody:picker ;
  rdfs:comment "Retired: reference the picker node with elody:picker."@en .
elody:pickerFilters a owl:DeprecatedProperty ; owl:deprecated true ;
  rdfs:label "picker filters (retired)"@en ; rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  dcterms:isReplacedBy elody:picker ;
  rdfs:comment "Retired: reference the picker node with elody:picker."@en .
elody:filtersQueryName a owl:DeprecatedProperty ; owl:deprecated true ;
  rdfs:label "filters query name (retired)"@en ; rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  dcterms:isReplacedBy elody:queryName ;
  rdfs:comment "Retired: a picker has one elody:queryName (optional); the filters document is named after it."@en .
elody:type a owl:DeprecatedProperty ; owl:deprecated true ;
  rdfs:label "type (retired)"@en ; rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  dcterms:isReplacedBy elody:graphqlType ;
  rdfs:comment "Retired: a picker result names its type with elody:graphqlType."@en .

# =============================================================================
# 7. Platform forms: documents the platform ships, referenced by node (R3)
# =============================================================================

elody:PlatformForm a owl:Class ; rdfs:subClassOf elody:Form ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "platform form"@en ;
  rdfs:comment "A form document the platform provides; a declaration references it with elody:form instead of naming its query."@en .

elody:EntityPickerForm a elody:PlatformForm ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "entity picker form"@en ;
  rdfs:comment "The generic pick-existing-entities form."@en .

elody:RemoveFromListForm a elody:PlatformForm ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "remove from list form"@en ;
  rdfs:comment "The generic confirm-removal form used by delete operations on an embedded list."@en .

# =============================================================================
# 8. Language-tagged text
# =============================================================================

elody:multilingual a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "multilingual"@en ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( shui:Editor elody:WysiwygElement ) ] ; rdfs:range xsd:boolean ;
  rdfs:comment "One text per language. On an editor (the shui: WithLang editors, which the SHACL 1.2 UI scoring system picks for rdf:langString): Elody renders its field as one multilingual value (isMultilingual), edited and shown per language. On a rich-text element, which has no datatype for it to follow from, the declaration says it here."@en .

shui:TextFieldWithLangEditor elody:multilingual true .
shui:TextAreaWithLangEditor  elody:multilingual true .

# =============================================================================
# 9. The other detail elements of the schema (EntityViewElements)
# =============================================================================
# Declared so a UI can be described completely; the generator renders them in a
# later step and refuses them until then (no silent fallback to a window).
# Nested platform configuration that is not presentation (map feature metadata,
# tagging configuration, editor styles, transliteration) is left to hand-written
# GraphQL in "regions" mode for now.

elody:MediaFileElement a owl:Class ; rdfs:subClassOf elody:Element ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "media element"@en ;
  rdfs:comment "The entity's mediafiles in the platform viewer (IIIF, video, audio, PDF). No standard term: shui:ImageViewer shows one value, this is a gallery with its own viewer."@en .

elody:SingleMediaFileElement a owl:Class ; rdfs:subClassOf elody:Element ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "single media element"@en ;
  rdfs:comment "One mediafile (the primary one) in the platform viewer."@en .

elody:MapElement a owl:Class ; rdfs:subClassOf elody:Element ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "map element"@en ;
  rdfs:comment "The entity (or its related entities) on a map: points, WKT shapes or a heat map. No standard term: shui has no geographic viewer."@en .

elody:GraphElement a owl:Class ; rdfs:subClassOf elody:Element ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "graph element"@en ;
  rdfs:comment "A chart over a time series of the entity (IoT measurements). No standard term."@en .

elody:HierarchyListElement a owl:Class ; rdfs:subClassOf elody:Element ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "hierarchy list element"@en ;
  rdfs:comment "A tree of related entities, one level per relation, with the entity as centre point. No standard term."@en .

elody:ManifestViewerElement a owl:Class ; rdfs:subClassOf elody:Element ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "IIIF manifest element"@en ;
  rdfs:comment "A IIIF viewer on a manifest URL read from the entity's metadata."@en .

elody:EntityViewerElement a owl:Class ; rdfs:subClassOf elody:Element ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "embedded entity element"@en ;
  rdfs:comment "Another entity's detail embedded in this page, found through a relation type or a metadata key. Closest standard idea is shui:DetailsViewer, but that shows a nested node of the same graph, not a separate entity."@en .

elody:ActionElement a owl:Class ; rdfs:subClassOf elody:Element ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "action element"@en ;
  rdfs:comment "A block of buttons for platform actions on the entity (OCR, download)."@en .

elody:WysiwygElement a owl:Class ; rdfs:subClassOf elody:Element ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "rich text element"@en ;
  rdfs:comment "A rich-text editor on one metadata key, with optional entity tagging. Elody's counterpart of shui:RichTextEditor, but as a page block rather than a form field."@en .

elody:CommentsElement a owl:Class ; rdfs:subClassOf elody:Element ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "comments element"@en ;
  rdfs:comment "A comment thread on the entity, written with a rich-text composer."@en .

# -- enumerations used by these elements ------------------------------------------

elody:MediaElementKind a owl:Class ; rdfs:label "media element kind"@en ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:comment "Enumeration of MediaFileElementTypes."@en .
elody:MediaKindMedia a elody:MediaElementKind ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:MediaKindMap   a elody:MediaElementKind ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .

elody:MapType a owl:Class ; rdfs:label "map type"@en ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:comment "Enumeration of MapTypes."@en .
elody:PointsMap a elody:MapType ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:WktMap    a elody:MapType ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:HeatMap   a elody:MapType ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .

elody:GraphType a owl:Class ; rdfs:label "chart type"@en ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:comment "Enumeration of GraphType."@en .
elody:BarGraph       a elody:GraphType ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:BubbleGraph    a elody:GraphType ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:DoughnutGraph  a elody:GraphType ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:LineGraph      a elody:GraphType ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:PieGraph       a elody:GraphType ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:PolarAreaGraph a elody:GraphType ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:RadarGraph     a elody:GraphType ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:ScatterGraph   a elody:GraphType ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .

elody:TimeUnit a owl:Class ; rdfs:label "time unit"@en ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:comment "Enumeration of TimeUnit: how a graph buckets its time series."@en .
elody:Month     a elody:TimeUnit ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:Hour      a elody:TimeUnit ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:DayOfYear a elody:TimeUnit ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:DayOfWeek a elody:TimeUnit ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> .

elody:ElementAction a owl:Class ; rdfs:label "element action"@en ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:comment "Enumeration of Actions offered by an action element."@en .
elody:OcrAction      a elody:ElementAction ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:DownloadAction a elody:ElementAction ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:NoActions      a elody:ElementAction ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .

elody:WysiwygExtension a owl:Class ; rdfs:label "rich text extension"@en ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:comment "Enumeration of WysiwygExtensions: the editor features a rich text element switches on."@en .
elody:StarterKitExtension a elody:WysiwygExtension ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:DocExtension        a elody:WysiwygExtension ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:ParagraphExtension  a elody:WysiwygExtension ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:TextExtension       a elody:WysiwygExtension ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:HardBreakExtension  a elody:WysiwygExtension ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:BoldExtension       a elody:WysiwygExtension ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:ItalicExtension     a elody:WysiwygExtension ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:ColorExtension      a elody:WysiwygExtension ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:TextStyleExtension  a elody:WysiwygExtension ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:ListItemExtension   a elody:WysiwygExtension ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:TaggingExtension    a elody:WysiwygExtension ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .

# -- properties of these elements ---------------------------------------------------

elody:mediaKind a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "media kind"@en ; rdfs:range elody:MediaElementKind ;
  rdfs:domain [ owl:unionOf ( elody:MediaFileElement elody:SingleMediaFileElement elody:ListElement ) ] ;
  rdfs:comment "Whether the media element shows the mediafiles or their locations; on a list element, that the list is one of media files (type(input: media))."@en .
elody:customQueryRelationType a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "custom query relation type"@en ; rdfs:domain elody:ListElement ; rdfs:range xsd:string ;
  rdfs:comment "The relation the list's entities document is scoped by on the related side (customQueryRelationType), when it differs from the list's relation."@en .

elody:mapType a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "map type"@en ; rdfs:domain elody:MapElement ; rdfs:range elody:MapType ;
  rdfs:comment "Points, WKT shapes or heat map."@en .
elody:center a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "center"@en ; rdfs:domain elody:MapElement ; rdfs:range xsd:string ;
  rdfs:comment "Initial map centre as \"lat,lon\"."@en .

elody:graphType a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "chart type"@en ; rdfs:domain elody:GraphElement ; rdfs:range elody:GraphType ;
  rdfs:comment "Which chart."@en .
elody:datasource a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "data source"@en ; rdfs:domain elody:GraphElement ; rdfs:range xsd:string ;
  rdfs:comment "The time-series source the chart reads."@en .
elody:datasetLabel a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "dataset label"@en ; rdfs:domain elody:GraphElement ; rdfs:range xsd:string ;
  rdfs:comment "A series to plot (dataset.labels)."@en .
elody:datasetFilter a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "dataset filter"@en ; rdfs:domain elody:GraphElement ; rdfs:range elody:ConfigEntry ;
  rdfs:comment "Restricts the series: elody:key and one or more elody:value."@en .
elody:timeUnit a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "time unit"@en ; rdfs:domain elody:GraphElement ; rdfs:range elody:TimeUnit ;
  rdfs:comment "How the chart buckets time."@en .
elody:datapoints a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "data points"@en ; rdfs:domain elody:GraphElement ; rdfs:range xsd:integer ;
  rdfs:comment "How many buckets to show."@en .
elody:convertTo a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "convert to"@en ; rdfs:domain elody:GraphElement ; rdfs:range xsd:string ;
  rdfs:comment "Unit the values are converted to before plotting."@en .

elody:hierarchyLevel a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "hierarchy level"@en ; rdfs:domain elody:HierarchyListElement ; rdfs:range elody:ConfigEntry ;
  rdfs:comment "One level of the tree: elody:key is the relation, elody:entityType the type at that level; ordered by sh:order."@en .
elody:centerEntityType a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "centre entity type"@en ; rdfs:domain elody:HierarchyListElement ; rdfs:range xsd:string ;
  rdfs:comment "The entity type the tree is centred on."@en .
elody:centerCoordinatesKey a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "centre coordinates key"@en ; rdfs:domain elody:HierarchyListElement ; rdfs:range xsd:string ;
  rdfs:comment "The metadata key holding the centre point's coordinates."@en .

elody:manifestUrlKey a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "manifest URL key"@en ; rdfs:domain elody:ManifestViewerElement ; rdfs:range xsd:string ;
  rdfs:comment "The metadata key holding the IIIF manifest URL."@en .
elody:manifestVersionKey a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "manifest version key"@en ; rdfs:domain elody:ManifestViewerElement ; rdfs:range xsd:string ;
  rdfs:comment "The metadata key holding the IIIF Presentation API version."@en .

elody:elementAction a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "action"@en ; rdfs:domain elody:ActionElement ; rdfs:range elody:ElementAction ;
  rdfs:comment "An action button of the element."@en .

elody:extension a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "extension"@en ; rdfs:domain elody:WysiwygElement ; rdfs:range elody:WysiwygExtension ;
  rdfs:comment "An editor feature switched on."@en .
elody:infoTitle a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "info title"@en ; rdfs:domain elody:Element ; rdfs:range xsd:string ;
  rdfs:comment "Title of the help panel next to the element (translation key)."@en .
elody:infoContent a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "info content"@en ; rdfs:domain elody:Element ; rdfs:range xsd:string ;
  rdfs:comment "Content of the help panel (HTML)."@en .

elody:composer a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "composer"@en ; rdfs:domain elody:CommentsElement ; rdfs:range elody:WysiwygElement ;
  rdfs:comment "The rich-text element used to write a comment."@en .
elody:parentFilterKey a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "parent filter key"@en ; rdfs:domain owl:Thing ; rdfs:range xsd:string ;
  rdfs:comment "On a filter: the parentKey argument of a selection filter (\"relations\"). On a comments element: the filter key that ties comments to this entity."@en .

# ---- 0.3.0, batch 5: validation rules, permissions, typed filter documents, static filter options,
#      column aliases, panel permissions (askforceone) ------------------------------------------

elody:validationRule a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "validation rule"@en ; rdfs:domain sh:PropertyShape ; rdfs:range xsd:string ;
  rdfs:comment "A validation the field's input runs beyond required (validation(input: { value: url }): url, email, regex, customValue, has_required_relation, ...). sh:minCount 1 says required; this says the rest. Open string: the rules are the PWA's."@en .
elody:validationValue a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "validation value"@en ; rdfs:domain sh:PropertyShape ; rdfs:range xsd:string ;
  rdfs:comment "The argument of the validation rule (customValue: \"min_value:1\", the pattern of a regex)."@en .
elody:readsPermissions a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "reads permissions"@en ; rdfs:domain elody:EntityUi ; rdfs:range xsd:boolean ;
  rdfs:comment "true reads canUpdate and canDelete with the detail page's initial values: the PWA shows the edit and delete actions by them. Default false."@en .
elody:filtersType a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "filters type"@en ; rdfs:domain owl:Thing ; rdfs:range xsd:string ;
  rdfs:comment "On a list query or picker: the GraphQL type its filters document narrows to (EntityTypeFilters { ... on QuestionInstance { advancedFilters { ... } } }). Without it the filters are selected on EntityTypeFilters itself."@en .
elody:FilterOption a owl:Class ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "filter option"@en ;
  rdfs:comment "One fixed option of a selection filter (options: [{ label, value }]): a label key and a value, in sh:order."@en .
elody:option a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "option"@en ; rdfs:domain elody:Filter ; rdfs:range elody:FilterOption ;
  rdfs:comment "A fixed option of a selection filter, offered as declared instead of fetched (elody:optionsType). Its label is elody:labelKey, its value elody:value."@en .

# ---- 0.3.0, batch 6: vlacc's listing structure and card keys --------------------------------

elody:listingCore a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "listing core"@en ; rdfs:domain elody:EntityUi ; rdfs:range xsd:boolean ;
  rdfs:comment "true splits the listing fragment in two: minimal<Type>Core holds the values and the card, minimal<Type> spreads it and adds the view modes, so other listings of the type can reuse the core. Default false."@en .
elody:cardKey a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "card key"@en ; rdfs:domain sh:PropertyShape ; rdfs:range xsd:string ;
  rdfs:comment "The key the card field reads its value under (key(input: ...)) when it is neither the metadata key nor the alias (\"typePill\" for the type pill, a raw key under a title alias)."@en .
elody:selectionSpread a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "selection spread"@en ; rdfs:domain elody:Filter ; rdfs:range xsd:string ;
  rdfs:comment "The name of a shared fragment that is the filter's selection set (...advancedFilter) in place of the fields asked back one by one; fields with arguments (defaultValue, hidden, tooltip) are still emitted."@en .
elody:elementSpread a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "element spread"@en ; rdfs:domain owl:Thing ; rdfs:range xsd:string ;
  rdfs:comment "On a column: the name of a shared fragment on EntityViewElements spread among the column's elements (...entityHistoryVersionList)."@en .
elody:repeatableMetadataKey a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "repeatable metadata key"@en ; rdfs:domain sh:PropertyShape ; rdfs:range xsd:string ;
  rdfs:comment "With elody:source elody:RepeatableMetadataSource: the key inside the repeatable group the value is read from (repeatableMetadataKey)."@en .
elody:parentRelationType a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "parent relation type"@en ; rdfs:domain [ a owl:Class ; owl:unionOf ( sh:PropertyShape elody:ParentRelation ) ] ; rdfs:range xsd:string ;
  rdfs:comment "With elody:source elody:ParentRootSource: the relation over which the parent entity is reached (parentRelations: [{ relationType }])."@en .
elody:containsRelationPropertyKey a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "contains relation property key"@en ; rdfs:domain sh:PropertyShape ; rdfs:range xsd:string ;
  rdfs:comment "On a relation-valued property: only the relations whose property with this key holds elody:containsRelationPropertyValue are read (containsRelationPropertyKey: \"main_author\")."@en .
elody:containsRelationPropertyValue a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "contains relation property value"@en ; rdfs:domain sh:PropertyShape ; rdfs:range xsd:string ;
  rdfs:comment "The value elody:containsRelationPropertyKey selects on (containsRelationPropertyValue: \"true\")."@en .

# ---- 0.3.0, batch 7: vlacc's detail extras -----------------------------------------------------

elody:sortPrimary a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "primary sort option"@en ; rdfs:domain sh:PropertyShape ; rdfs:range xsd:boolean ;
  rdfs:comment "true marks the property's sort option as the primary one (primary: true). Default false."@en .
elody:listingFormatter a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "listing formatter"@en ; rdfs:domain sh:PropertyShape ; rdfs:range xsd:boolean ;
  rdfs:comment "false reads the value in the listing fragment without its formatter (the detail page keeps it). Default true."@en .
elody:hideInHistory a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "hide in history"@en ; rdfs:domain elody:Element ; rdfs:range xsd:boolean ;
  rdfs:comment "true leaves the element out of the history view of the entity (hideInHistory(input: true)). Default false."@en .
elody:disableLibraryBar a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "disable library bar"@en ; rdfs:domain elody:ListElement ; rdfs:range xsd:boolean ;
  rdfs:comment "true hides the list's library bar (disableLibraryBar(input: true)). Default false."@en .
elody:enableNavigation a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "enable navigation"@en ; rdfs:domain elody:ListElement ; rdfs:range xsd:boolean ;
  rdfs:comment "Whether the list's items navigate to their detail page (enableNavigation(input: ...)). Unsaid leaves the PWA's default."@en .
elody:libraryMode a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "library mode"@en ; rdfs:domain elody:ListElement ; rdfs:range xsd:string ;
  rdfs:comment "The list's base library mode (baseLibraryMode(input: ...)). Open string: the modes are the PWA's."@en .
elody:keys a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "keys"@en ; rdfs:domain elody:Filter ; rdfs:range rdf:List ;
  rdfs:comment "An ordered RDF list of the keys a filter searches (key: [\"a\", \"b\"]) when there are several; elody:key holds one."@en .
elody:requiresSameType a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "requires same type"@en ; rdfs:domain elody:ActionContext ; rdfs:range xsd:boolean ;
  rdfs:comment "true offers the bulk operation only when the selected items share a type (requiresSameType)."@en .
elody:minSelectedItems a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "min selected items"@en ; rdfs:domain elody:ActionContext ; rdfs:range xsd:integer ;
  rdfs:comment "The least items that must be selected for the bulk operation (minSelectedItems)."@en .
elody:maxSelectedItems a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "max selected items"@en ; rdfs:domain elody:ActionContext ; rdfs:range xsd:integer ;
  rdfs:comment "The most items that may be selected for the bulk operation (maxSelectedItems)."@en .
elody:DeleteOptions a owl:Class ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "delete options"@en ;
  rdfs:comment "How a type's entity is deleted from its detail page (deleteQueryOptions): the labels, the documents listing the relations to delete with it and the relations that block the deletion."@en .
elody:deleteOptions a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "delete options"@en ; rdfs:domain elody:EntityUi ; rdfs:range elody:DeleteOptions ;
  rdfs:comment "The deleteQueryOptions block of the detail fragment."@en .
elody:deleteEntityLabel a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ; rdfs:label "delete entity label"@en ; rdfs:domain elody:DeleteOptions ; rdfs:range xsd:string ;
  rdfs:comment "The translation key of the delete confirmation (deleteEntityLabel)."@en .
elody:deleteRelationsQuery a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ; rdfs:label "delete relations query"@en ; rdfs:domain elody:DeleteOptions ; rdfs:range xsd:string ;
  rdfs:comment "The document listing the related entities deleted along (customQueryDeleteRelations)."@en .
elody:deleteRelationsFilters a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ; rdfs:label "delete relations filters"@en ; rdfs:domain elody:DeleteOptions ; rdfs:range xsd:string ;
  rdfs:comment "Its filters document (customQueryDeleteRelationsFilters)."@en .
elody:deleteRelationsTypes a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ; rdfs:label "delete relations types"@en ; rdfs:domain elody:DeleteOptions ; rdfs:range rdf:List ;
  rdfs:comment "An ordered RDF list of the entity types deleted along (customQueryEntityTypes)."@en .
elody:deleteRelationsLabel a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ; rdfs:label "delete relations label"@en ; rdfs:domain elody:DeleteOptions ; rdfs:range xsd:string ;
  rdfs:comment "The translation key naming the related entities (deleteRelationsLabel)."@en .
elody:blockingRelationsQuery a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ; rdfs:label "blocking relations query"@en ; rdfs:domain elody:DeleteOptions ; rdfs:range xsd:string ;
  rdfs:comment "The document listing the related entities that block the deletion (customQueryBlockingRelations)."@en .
elody:blockingRelationsFilters a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ; rdfs:label "blocking relations filters"@en ; rdfs:domain elody:DeleteOptions ; rdfs:range xsd:string ;
  rdfs:comment "Its filters document (customQueryBlockingRelationsFilters)."@en .
elody:blockingRelationsTypes a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ; rdfs:label "blocking relations types"@en ; rdfs:domain elody:DeleteOptions ; rdfs:range rdf:List ;
  rdfs:comment "An ordered RDF list of the entity types that block the deletion (customQueryBlockingEntityTypes)."@en .
elody:blockingRelationsLabel a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ; rdfs:label "blocking relations label"@en ; rdfs:domain elody:DeleteOptions ; rdfs:range xsd:string ;
  rdfs:comment "The translation key naming the blocking entities (blockingRelationsLabel)."@en .
elody:detailLabelKey a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "detail label key"@en ; rdfs:domain sh:PropertyShape ; rdfs:range xsd:string ;
  rdfs:comment "The translation key the detail panel labels the field with when it differs from the card's (elody:labelKey)."@en .

# ---- 0.3.0, batch 9: several create forms per type, shared field fragments ----------------------

elody:fieldsSpread a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "fields spread"@en ; rdfs:domain elody:Form ; rdfs:range xsd:string ;
  rdfs:comment "The name of a hand-written fragment on FormFields spread among the form's fields (...basicCreateExpressionFields): fields several forms of a family share. A form may hold spreads only."@en .
elody:CopyFromParent a owl:Class ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "copy from parent"@en ;
  rdfs:comment "How a create form prefills its fields from the entity it is opened on (copyFromParent): all of them (elody:autoCopy) and/or a key map."@en .
elody:copyFromParent a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "copy from parent"@en ; rdfs:domain elody:Form ; rdfs:range elody:CopyFromParent ;
  rdfs:comment "The form's copyFromParent block."@en .
elody:autoCopy a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "auto copy"@en ; rdfs:domain elody:CopyFromParent ; rdfs:range xsd:boolean ;
  rdfs:comment "true copies every field the parent shares (autoCopy)."@en .
elody:copyKey a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "copy key"@en ; rdfs:domain elody:CopyFromParent ;
  rdfs:comment "One keyMap entry: the field (elody:key) filled from the parent's key (elody:fromKey), in sh:order."@en .
elody:fromKey a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "from key"@en ; rdfs:range xsd:string ;
  rdfs:comment "The parent's key a copied field is filled from (keyMap.fromKey)."@en .
elody:validationRelationType a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "validation relation type"@en ; rdfs:domain sh:PropertyShape ; rdfs:range xsd:string ;
  rdfs:comment "With elody:validationRule \"has_required_relation\": the relation that must be present (has_required_relation.relationType)."@en .
elody:validationAmount a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "validation amount"@en ; rdfs:domain sh:PropertyShape ; rdfs:range xsd:integer ;
  rdfs:comment "With elody:validationRule \"has_required_relation\": how many related entities are required (has_required_relation.amount)."@en .
elody:validationExact a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "validation exact"@en ; rdfs:domain sh:PropertyShape ; rdfs:range xsd:boolean ;
  rdfs:comment "With elody:validationRule \"has_required_relation\": true requires exactly elody:validationAmount related entities (has_required_relation.exact)."@en .

# ---- 0.3.0, batch 11: interface declarations and the fragments a type family shares ----------

elody:interface a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "interface"@en ; rdfs:domain elody:EntityUi ; rdfs:range xsd:boolean ;
  rdfs:comment "true declares a GraphQL interface its subtypes share (Work, Expression): no listing or detail fragment is generated, only the filters, sort options and bulk operations fragments named after it, its documents and the fragments its subtypes spread. Default false."@en .
elody:fragmentName a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "fragment name"@en ; rdfs:domain owl:Thing ; rdfs:range xsd:string ;
  rdfs:comment "The GraphQL name of a shared fragment (basicCreateWorkFields, workTitleDataWindowElement, workTitleDataIntialValues)."@en .
elody:cardFragmentName a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "card fragment name"@en ; rdfs:domain elody:ValuesFragment ; rdfs:range xsd:string ;
  rdfs:comment "The name of the fragment on teaserMetadata showing the same fields on the card (relatedWorksTeaserMetadata), when there is one."@en .
elody:FieldsFragment a owl:Class ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "fields fragment"@en ;
  rdfs:comment "A named fragment on FormFields holding form fields several forms spread (elody:fieldsSpread): its fields are the property shapes of its elody:shape."@en .
elody:fieldsFragment a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "fields fragment"@en ; rdfs:domain elody:EntityUi ; rdfs:range elody:FieldsFragment ;
  rdfs:comment "A fields fragment the type's file holds."@en .
elody:ElementsFragment a owl:Class ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "elements fragment"@en ;
  rdfs:comment "A named fragment on EntityViewElements holding detail elements several types spread in a column (elody:elementSpread)."@en .
elody:elementsFragment a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "elements fragment"@en ; rdfs:domain elody:EntityUi ; rdfs:range elody:ElementsFragment ;
  rdfs:comment "An elements fragment the type's file holds; its panels reference the type's property shapes."@en .
elody:ValuesFragment a owl:Class ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "values fragment"@en ;
  rdfs:comment "A named fragment on IntialValues reading some of the type's property shapes (elody:field), spread by other fragments (elody:detailValuesSpread), with an optional twin on teaserMetadata (elody:cardFragmentName)."@en .
elody:valuesFragment a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "values fragment"@en ; rdfs:domain elody:EntityUi ; rdfs:range elody:ValuesFragment ;
  rdfs:comment "A values fragment the type's file holds."@en .

# ---- 0.3.0, batch 12: list query results selected inline ----------------------------------------

elody:listing a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "listing"@en ; rdfs:domain owl:Thing ; rdfs:range elody:EntityUi ;
  rdfs:comment "On a list query's or picker's result: an EntityUi with elody:emit \"inline\" whose listing (values, card, view modes) is rendered inside the result (... on Person { intialValues { ... } teaserMetadata { ... } }) instead of, or next to, a fragment spread (elody:fragment)."@en .
elody:menuInButtons a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "menu in buttons"@en ; rdfs:domain elody:ContextMenu ; rdfs:range xsd:boolean ;
  rdfs:comment "true emits the card's context menu in the newer form, buttons { contextMenu { ... } }, instead of contextMenuActions { ... }. Default false."@en .
elody:actionForm a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "action form"@en ; rdfs:domain elody:Action ; rdfs:range xsd:string ;
  rdfs:comment "The GraphQL field a context-menu action is emitted as: doElodyAction (default, with an elody:actionKind), doLinkAction (follow the entity's link: label and icon only), doGeneralAction or doCustomAction."@en .

# ---- 0.3.0, batch 13: values read on a relation, from the host entity, from the parent; editable card fields ----

elody:relationKey a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "relation key"@en ; rdfs:domain sh:PropertyShape ; rdfs:range xsd:string ;
  rdfs:comment "With elody:source elody:RelationMetadataSource or elody:RelationRootdataSource: the relation whose own metadata the value is read from (relationKey: \"refAuthors\")."@en .
elody:readsHost a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "reads host"@en ; rdfs:domain owl:Thing ; rdfs:range xsd:boolean ;
  rdfs:comment "On a property shape: true reads the value relative to the entity the list is shown on (the keyValue takes uuid: $userUuid). On a list query or picker: the document declares $userUuid: String! (derived too from a result listing that reads the host). Default false."@en .
elody:relationDirection a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "relation direction"@en ; rdfs:domain sh:PropertyShape ; rdfs:range xsd:string ;
  rdfs:comment "The direction the relation is read in (relationDirection: fromRelatedEntity). Open string: the directions are the PWA's."@en .
elody:parentEntityType a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "parent entity type"@en ; rdfs:domain [ a owl:Class ; owl:unionOf ( sh:PropertyShape elody:ParentRelation ) ] ; rdfs:range xsd:string ;
  rdfs:comment "With a parent source: the type of the parent entity when it is found by a key rather than a relation (parentRelations: [{ entityType: zizo, key: [...] }]), with elody:parentKey."@en .
elody:parentKey a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "parent key"@en ; rdfs:domain [ a owl:Class ; owl:unionOf ( sh:PropertyShape elody:ParentRelation ) ] ; rdfs:range xsd:string ;
  rdfs:comment "The document key the parent entity is found by (parentRelations[].key), with elody:parentEntityType."@en .
elody:cardField a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "card field"@en ; rdfs:domain sh:PropertyShape ; rdfs:range xsd:string ;
  rdfs:comment "The field the card shows the property as when not metaData: relationRootData (a root field of the relation the card stands for) or relationMetaData (metadata of that relation)."@en .
elody:cardEditable a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "card editable"@en ; rdfs:domain sh:PropertyShape ; rdfs:range xsd:boolean ;
  rdfs:comment "true edits the property on the card itself: the card field carries the property's input field (inputField(type: ...) { ...inputfield }). Default false."@en .

# ---- 0.3.0, batch 14: sub-operations and where a modal navigates after creating ----------------

elody:subOperation a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "sub-operation"@en ; rdfs:domain elody:BulkOperation ; rdfs:range elody:BulkOperation ;
  rdfs:comment "A bulk operation offered under this one (subOptions: a dropdown of operations, the parent usually of kind elody:OpenDropdownOperation), in sh:order."@en .
elody:navigateAfterCreation a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "navigate after creation"@en ; rdfs:domain elody:BulkOperationModal ; rdfs:range xsd:string ;
  rdfs:comment "Where the PWA goes once the modal's form created the entity (pageToNavigateToAfterCreation: detailPage). Open string: the pages are the PWA's."@en .

# ---- 0.3.0, batch 15: the remaining bulk option settings (G-032) ---------------------------------

elody:skipRelatedItems a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "skip related items"@en ; rdfs:domain elody:BulkOperationModal ; rdfs:range xsd:string ;
  rdfs:comment "A relation type whose holders a bulk delete leaves alone (skipItemsWithRelationDuringBulkDelete), one per value."@en .
elody:imageCrop a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "image crop"@en ; rdfs:domain elody:BulkOperationModal ; rdfs:range xsd:boolean ;
  rdfs:comment "true lets the modal crop the chosen image (enableImageCrop); elody:cropCoordinatesKey says where the crop is kept."@en .
elody:cropCoordinatesKey a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "crop coordinates key"@en ; rdfs:domain [ a owl:Class ; owl:unionOf ( elody:BulkOperationModal elody:ListElement ) ] ; rdfs:range xsd:string ;
  rdfs:comment "The metadata key the crop coordinates are saved under: on a modal keyToSaveCropCoordinates, on a media list cropMediafileCoordinatesKey."@en .
elody:replaceExistingRelations a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "replace existing relations"@en ; rdfs:domain elody:BulkOperationModal ; rdfs:range xsd:boolean ;
  rdfs:comment "true replaces the relations the modal's flow sets instead of adding to them (replaceExistingRelations)."@en .
elody:selectionLimit a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "selection limit"@en ; rdfs:domain elody:BulkOperationModal ; rdfs:range xsd:integer ;
  rdfs:comment "The most entities the modal's picker lets the user choose (selectionLimit)."@en .
elody:forms a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "forms"@en ; rdfs:domain elody:BulkOperationModal ; rdfs:range rdf:List ;
  rdfs:comment "The forms a modal may open, as an RDF list of form nodes in the order offered (formQueries with several names: a bulk edit over several subtypes). A modal opening one form uses elody:form."@en .

elody:SurvivorSuggestion a owl:Class ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "survivor suggestion"@en ;
  rdfs:comment "How a merge modal suggests which of the selected entities survives (survivorSuggestion)."@en .
elody:survivorSuggestion a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "survivor suggestion"@en ; rdfs:domain elody:BulkOperationModal ; rdfs:range elody:SurvivorSuggestion ;
  rdfs:comment "The merge modal's survivor suggestion."@en .
elody:SurvivorStrategy a owl:Class ; rdfs:label "survivor strategy"@en ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:comment "Enumeration of the ways a merge picks its recommended survivor."@en .
elody:IdentifierIntegrityStrategy a elody:SurvivorStrategy ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:comment "The entity whose identifiers stay intact survives."@en .
elody:survivorStrategy a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "survivor strategy"@en ; rdfs:domain elody:SurvivorSuggestion ; rdfs:range elody:SurvivorStrategy ;
  rdfs:comment "The strategy the suggestion follows (strategy)."@en .
elody:autoSelectSurvivor a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "auto-select survivor"@en ; rdfs:domain elody:SurvivorSuggestion ; rdfs:range xsd:boolean ;
  rdfs:comment "true preselects the recommended survivor (autoSelect)."@en .
elody:requireRecommendedSurvivor a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "require recommended survivor"@en ; rdfs:domain elody:SurvivorSuggestion ; rdfs:range xsd:boolean ;
  rdfs:comment "true only lets the recommended survivor be chosen (requireRecommendedSurvivor)."@en .
elody:MergeVerdict a owl:Class ; rdfs:label "merge verdict"@en ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:comment "Enumeration of the verdicts a merge evaluation gives a candidate."@en .
elody:ValidVerdict   a elody:MergeVerdict ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:InvalidVerdict a elody:MergeVerdict ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:UnknownVerdict a elody:MergeVerdict ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:hiddenVerdict a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "hidden verdict"@en ; rdfs:domain elody:SurvivorSuggestion ; rdfs:range elody:MergeVerdict ;
  rdfs:comment "A verdict the merge modal does not show (hiddenVerdicts), one per value."@en .

elody:MetadataMatch a owl:Class ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "metadata match"@en ;
  rdfs:comment "A metadata key and the value it must hold for a bulk operation to be offered (matchMetadataValue)."@en .
elody:matchMetadataValue a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "match metadata value"@en ; rdfs:domain elody:ActionContext ; rdfs:range elody:MetadataMatch ;
  rdfs:comment "A metadata match the action context requires, one per node, in sh:order."@en .
elody:matchKey a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "match key"@en ; rdfs:domain elody:MetadataMatch ; rdfs:range xsd:string ;
  rdfs:comment "The metadata key matched (matchKey)."@en .
elody:matchValue a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "match value"@en ; rdfs:domain elody:MetadataMatch ; rdfs:range xsd:string ;
  rdfs:comment "The value the key must hold, as a string (matchValue)."@en .

# ---- 0.3.0, batch 16: option retrieval with several inputs and operators (G-034) ---------------

elody:optionsOperator a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "options operator"@en ; rdfs:domain elody:Filter ; rdfs:range xsd:string ;
  rdfs:comment "The operator of the option search on elody:optionsKey (advancedFilterInputForRetrievingOptions[].operator: or, and)."@en .
elody:optionsTypeOperator a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "options type operator"@en ; rdfs:domain elody:Filter ; rdfs:range xsd:string ;
  rdfs:comment "The operator of the type input scoping the option search ({ type: type, value: ..., operator: and })."@en .
elody:OptionsInput a owl:Class ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "options input"@en ;
  rdfs:comment "A further input narrowing a selection filter's option search (advancedFilterInputForRetrievingOptions beyond the search on elody:optionsKey and the type): a key, the value it must hold (a string or an RDF list of strings), and how it matches."@en .
elody:optionsInput a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "options input"@en ; rdfs:domain elody:Filter ; rdfs:range elody:OptionsInput ;
  rdfs:comment "A further input of the option search, in sh:order, rendered between the search on elody:optionsKey and the type input. elody:key and elody:value say what it matches; an input of kind elody:TypeFilter is the type input kept at its place among the others (instead of elody:optionsType)."@en .
elody:inputKind a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "input kind"@en ; rdfs:domain elody:OptionsInput ; rdfs:range elody:FilterKind ;
  rdfs:comment "The kind of the input (type: text, selection, ...), an elody:FilterKind instance."@en .
elody:inputMatchExact a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "input match exact"@en ; rdfs:domain elody:OptionsInput ; rdfs:range xsd:boolean ;
  rdfs:comment "Whether the input matches exactly (match_exact)."@en .
elody:inputDistinctBy a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "input distinct by"@en ; rdfs:domain elody:OptionsInput ; rdfs:range xsd:string ;
  rdfs:comment "The key the input's matches are made distinct by (distinct_by)."@en .
elody:inputOperator a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "input operator"@en ; rdfs:domain elody:OptionsInput ; rdfs:range xsd:string ;
  rdfs:comment "The input's operator (operator: or, and)."@en .

# ---- 0.3.0, batch 17: window status, actions on a list's result, media and map elements (G-025) --

elody:WindowStatus a owl:Class ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "window status"@en ;
  rdfs:comment "A status shown and edited in a window element's header (windowElementStatus): a metadata key with its input field."@en .
elody:windowStatus a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "window status"@en ; rdfs:domain elody:WindowElement ; rdfs:range elody:WindowStatus ;
  rdfs:comment "The window's status (windowElementStatus(windowElementStatusInput: ...))."@en .
elody:statusKey a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "status key"@en ; rdfs:domain elody:WindowStatus ; rdfs:range xsd:string ;
  rdfs:comment "The metadata key holding the status (statusMetadataKey)."@en .
elody:statusInputField a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "status input field"@en ; rdfs:domain elody:WindowStatus ; rdfs:range xsd:string ;
  rdfs:comment "The input field type editing the status (statusInputFieldType), a BaseFieldType value the client may extend."@en .

elody:ActionsOnResult a owl:Class ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "actions on result"@en ;
  rdfs:comment "Operations a list offers on its result (actionsOnResult): for instance a create button when the list is empty."@en .
elody:actionsOnResult a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "actions on result"@en ; rdfs:domain elody:ListElement ; rdfs:range elody:ActionsOnResult ;
  rdfs:comment "The list's actions on its result, with elody:operation nodes in sh:order."@en .
elody:ResultKind a owl:Class ; rdfs:label "result kind"@en ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:comment "Enumeration of the results a list's actions answer to (ActionsOnResultTypes)."@en .
elody:NoResult a elody:ResultKind ; rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:comment "The list is empty."@en .
elody:resultKind a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "result kind"@en ; rdfs:domain elody:ActionsOnResult ; rdfs:range elody:ResultKind ;
  rdfs:comment "The result the actions answer to (type(input: NoResult))."@en .
elody:addEntitiesToForms a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "add entities to forms"@en ; rdfs:domain elody:ListElement ; rdfs:range xsd:boolean ;
  rdfs:comment "true passes the list's entities to the forms opened from it (addEntitiesToForms)."@en .

elody:mapFeatureField a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "map feature field"@en ; rdfs:domain elody:EntityUi ; rdfs:range sh:PropertyShape ;
  rdfs:comment "A property shown in the entity's popup on the map view (mapElement { mapFeatureMetadata { ... } } in the listing), referenced by its sh:path, in declaration order."@en .
elody:wktKey a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "WKT key"@en ; rdfs:domain elody:MapElement ; rdfs:range xsd:string ;
  rdfs:comment "The metadata key holding the WKT geometry the map element draws (wkt: metaData { key(input: ...) })."@en .

elody:MapViewKind a owl:Class ; rdfs:label "map view kind"@en ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:comment "Enumeration of the base layers a map view shows (MapViews), a view mode config value (mapView)."@en .
elody:SatelliteView a elody:MapViewKind ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:StandardView  a elody:MapViewKind ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:MapModeKind a owl:Class ; rdfs:label "map mode kind"@en ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:comment "Enumeration of the ways a map view draws its entities (MapModes), a view mode config value (mapMode)."@en .
elody:HeatMode    a elody:MapModeKind ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:DefaultMode a elody:MapModeKind ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:PointsMode  a elody:MapModeKind ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .

# ---- 0.3.0, batch 18: card, panel, form, menu and sort-option extras (G-029) --------------------

elody:cardLineClamp a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "card line clamp"@en ; rdfs:domain sh:PropertyShape ; rdfs:range xsd:string ;
  rdfs:comment "The lines the value is clamped to on the card (lineClamp(input: \"3\"))."@en .
elody:panelLineClamp a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "panel line clamp"@en ; rdfs:domain sh:PropertyShape ; rdfs:range xsd:string ;
  rdfs:comment "The lines the value is clamped to in the panel (lineClamp(input: \"3\"))."@en .
elody:panelAlias a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "panel alias"@en ; rdfs:domain sh:PropertyShape ; rdfs:range xsd:string ;
  rdfs:comment "The GraphQL alias the panel field is shown under when it differs from the value's."@en .
elody:highlightIfPrimaryThumbnail a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "highlight if primary thumbnail"@en ; rdfs:domain sh:PropertyShape ; rdfs:range xsd:boolean ;
  rdfs:comment "true highlights the card field when the entity is the primary thumbnail (highlightIfPrimaryThumbnail)."@en .
elody:validationMessage a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "validation message"@en ; rdfs:domain sh:PropertyShape ; rdfs:range xsd:string ;
  rdfs:comment "The translation key of the message shown while the value fails the rule (fastValidationMessage)."@en .
elody:filterAggregation a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "filter aggregation"@en ; rdfs:domain elody:Filter ; rdfs:range xsd:string ;
  rdfs:comment "The aggregation a number filter applies to a looked-up list (aggregation: \"size\")."@en .
elody:permitted a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "permitted"@en ; rdfs:domain sh:PropertyShape ; rdfs:range xsd:string ;
  rdfs:comment "A permission the panel field needs (permitted(input: [...])), one per value."@en .
elody:linkText a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "link text"@en ; rdfs:domain sh:PropertyShape ; rdfs:range xsd:string ;
  rdfs:comment "The translation key of the text shown for a link value in the panel (linkText)."@en .
elody:copyToClipboard a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "copy to clipboard"@en ; rdfs:domain sh:PropertyShape ; rdfs:range xsd:boolean ;
  rdfs:comment "true offers a copy button next to the value in the panel (copyToClipboard)."@en .
elody:nonEditable a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "non-editable"@en ; rdfs:domain sh:PropertyShape ; rdfs:range xsd:boolean ;
  rdfs:comment "true keeps the field read-only in an editable panel (nonEditableField)."@en .
elody:tooltipKey a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "tooltip key"@en ; rdfs:domain owl:Thing ; rdfs:range xsd:string ;
  rdfs:comment "The translation key of the tooltip shown with a panel or form field (tooltip(input: ...))."@en .
elody:panelShowsUnit a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "panel shows unit"@en ; rdfs:domain sh:PropertyShape ; rdfs:range xsd:boolean ;
  rdfs:comment "false leaves elody:unit off the panel field (the card still shows it). Default true."@en .
elody:valueTranslationKey a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "value translation key"@en ; rdfs:domain sh:PropertyShape ; rdfs:range xsd:string ;
  rdfs:comment "The translation key pattern the value is shown through (valueTranslationKey(input: \"access-levels.$value\"))."@en .
elody:cardAlias a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "card alias"@en ; rdfs:domain sh:PropertyShape ; rdfs:range xsd:string ;
  rdfs:comment "The GraphQL alias the card field is shown under when it differs from the value's (title: metaData { key(input: \"subdomain\") })."@en .
elody:cardValidates a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "card validates"@en ; rdfs:domain sh:PropertyShape ; rdfs:range xsd:boolean ;
  rdfs:comment "false leaves the validation off the card's input field (elody:cardEditable). Default true."@en .
elody:panelWidget a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "panel widget"@en ; rdfs:domain [ a owl:Class ; owl:unionOf ( sh:PropertyShape elody:PanelField ) ] ; rdfs:range xsd:boolean ;
  rdfs:comment "true gives the panel field its input field even in a read-only panel; on an elody:PanelField, true or false for that panel alone."@en .
elody:SortPage a owl:Class ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "sort page"@en ;
  rdfs:comment "A page a sort option is offered on (availableInPages): a route and the entity type shown there."@en .
elody:sortPage a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "sort page"@en ; rdfs:domain sh:PropertyShape ; rdfs:range elody:SortPage ;
  rdfs:comment "A page the property's sort option is offered on, one per node."@en .
elody:routeName a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "route name"@en ; rdfs:domain elody:SortPage ; rdfs:range xsd:string ;
  rdfs:comment "The PWA route (routeName: SingleEntity), an open string of the PWA's."@en .
elody:routeEntityType a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "route entity type"@en ; rdfs:domain elody:SortPage ; rdfs:range xsd:string ;
  rdfs:comment "The entity type shown on the route (entityType: asset)."@en .
elody:virtualKeyboardLayouts a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "virtual keyboard layouts"@en ; rdfs:domain sh:PropertyShape ; rdfs:range rdf:List ;
  rdfs:comment "The on-screen keyboard layouts a text field offers (virtualKeyboardConfig: layouts), an RDF list of names; on a form field or on a property shape edited in a panel."@en .
elody:PickerSearch a owl:Class ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "picker search"@en ;
  rdfs:comment "How an entity picker field searches (entityPickerSearchConfig): a mode, the keys searched and the types accepted."@en .
elody:pickerSearch a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "picker search"@en ; rdfs:domain sh:PropertyShape ; rdfs:range elody:PickerSearch ;
  rdfs:comment "The search configuration of an entity picker form field."@en .
elody:pickerSearchMode a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "picker search mode"@en ; rdfs:domain elody:PickerSearch ; rdfs:range xsd:string ;
  rdfs:comment "The search mode (mode: Search), an open string of the platform's."@en .
elody:noWidget a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "no widget"@en ; rdfs:domain sh:PropertyShape ; rdfs:range xsd:boolean ;
  rdfs:comment "true leaves the form field without an input field: a label the form shows (a bulk delete's list of items)."@en .
elody:submitAction a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "submit action"@en ; rdfs:domain owl:Thing ; rdfs:range xsd:string ;
  rdfs:comment "What the form's submit does (actionType: submit, ocr, submitWithUpload). Default submit."@en .
elody:showAsButton a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "show as button"@en ; rdfs:domain owl:Thing ; rdfs:range xsd:boolean ;
  rdfs:comment "true shows the menu action as a button of its own (showAsButton)."@en .
elody:repetitionKey a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "repetition key"@en ; rdfs:domain elody:Panel ; rdfs:range xsd:string ;
  rdfs:comment "The panel repeats per entry of this metadata key (repetitionConfig(repetitionKey: ...))."@en .
elody:displayConditionKey a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "display condition key"@en ; rdfs:domain elody:Panel ; rdfs:range xsd:string ;
  rdfs:comment "The panel is shown only when the entity holds this key (displayCondition { key(input: ...) })."@en .
elody:editableDefault a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "editable default"@en ; rdfs:domain elody:Panel ; rdfs:range xsd:boolean ;
  rdfs:comment "true leaves isEditable unsaid, to the platform's default; a panel without elody:panelKind leaves panelType unsaid likewise."@en .
elody:idField a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "id field"@en ; rdfs:domain elody:EntityUi ; rdfs:range xsd:boolean ;
  rdfs:comment "true reads the entity's id at the top of the listing fragment (id before intialValues)."@en .
elody:idValue a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "id value"@en ; rdfs:domain elody:EntityUi ; rdfs:range xsd:boolean ;
  rdfs:comment "true reads the id among the listing's initial values (intialValues { id ... })."@en .
elody:endpointUrl a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "endpoint URL"@en ; rdfs:domain owl:Thing ; rdfs:range xsd:string ;
  rdfs:comment "The API path a custom menu action calls (doCustomAction: endpointUrl), with $id for the entity."@en .
elody:endpointMethod a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "endpoint method"@en ; rdfs:domain owl:Thing ; rdfs:range xsd:string ;
  rdfs:comment "The HTTP method of the call (endpointMethod: POST)."@en .

# ---- 0.3.0, batch 19: a value read differently per page, a field shown differently per panel (G-028) ----

elody:listingValueLabelKey a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "listing value label key"@en ; rdfs:domain sh:PropertyShape ; rdfs:range xsd:string ;
  rdfs:comment "The metadata key labelling the relation in the listing when it differs from elody:valueLabelKey (the detail page's); \"\" reads it without a label key there."@en .
elody:listingValueLabelRootKey a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "listing value label root key"@en ; rdfs:domain sh:PropertyShape ; rdfs:range xsd:string ;
  rdfs:comment "The root key labelling the relation in the listing when it differs from elody:valueLabelRootKey; \"\" reads it without a root key there."@en .
elody:detailFormatter a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "detail formatter"@en ; rdfs:domain sh:PropertyShape ; rdfs:range xsd:boolean ;
  rdfs:comment "false reads the raw value on the detail page while the listing reads it with the viewer's formatter (the counterpart of elody:listingFormatter). Default true."@en .
elody:detailContainsRelation a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "detail contains relation"@en ; rdfs:domain sh:PropertyShape ; rdfs:range xsd:boolean ;
  rdfs:comment "false reads the relation on the detail page without the containsRelationProperty filter the listing applies. Default true."@en .
elody:viewModesOnDetail a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "view modes on detail"@en ; rdfs:domain elody:EntityUi ; rdfs:range xsd:boolean ;
  rdfs:comment "true reads the allowed view modes in the detail fragment too (allowedViewModes inside fullX)."@en .
elody:bulkDataSource a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "bulk data source"@en ; rdfs:domain elody:Panel ; rdfs:range xsd:string ;
  rdfs:comment "The metadata key a bulk-data panel shows as a whole (bulkData(bulkDataSource: ...))."@en .
elody:PanelField a owl:Class ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "panel field"@en ;
  rdfs:comment "How one panel shows one of its fields when that differs from the property shape: its own label key, alias or widget."@en .
elody:panelField a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "panel field"@en ; rdfs:domain elody:Panel ; rdfs:range elody:PanelField ;
  rdfs:comment "A field shown differently in this panel: elody:field names the property shape by its sh:path, elody:labelKey, elody:alias and elody:panelWidget say what differs."@en .
elody:panelSpread a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "panel spread"@en ; rdfs:domain elody:WindowElement ; rdfs:range xsd:string ;
  rdfs:comment "A hand-written fragment on WindowElement spread among the window's panels (...manifestationEanGroupPanel)."@en .
elody:technicalOrigin a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "technical origin"@en ; rdfs:domain sh:PropertyShape ; rdfs:range xsd:string ;
  rdfs:comment "The technical origin the value is read for (keyValue technicalOrigin: \"download\")."@en .
elody:readOnlyUnless a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "read-only unless"@en ; rdfs:domain sh:PropertyShape ; rdfs:range xsd:string ;
  rdfs:comment "A permission that unlocks editing the panel field (readOnly(input: [...])), one per value; without it the field stays read-only."@en .
elody:showOnlyInEditMode a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "show only in edit mode"@en ; rdfs:domain sh:PropertyShape ; rdfs:range xsd:boolean ;
  rdfs:comment "Whether the panel field is shown in edit mode only (showOnlyInEditMode)."@en .

# ---- 0.3.0, batch 20: a value through several parent relations, an optional host (G-026) --------

elody:ParentRelation a owl:Class ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "parent relation"@en ;
  rdfs:comment "One step to a parent entity (an entry of parentRelations): a relation type, or an entity type with the key the parent is found by."@en .
elody:parentRelation a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "parent relation"@en ; rdfs:domain sh:PropertyShape ; rdfs:range elody:ParentRelation ;
  rdfs:comment "A step to the parent the value is read from, in sh:order (parentRelations with several entries); one step is said with elody:parentRelationType or elody:parentEntityType + elody:parentKey on the shape itself."@en .
elody:hostOptional a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "host optional"@en ; rdfs:domain elody:ListQuery ; rdfs:range xsd:boolean ;
  rdfs:comment "true declares the host's uuid as a nullable variable ($userUuid: String) on a list query that reads the host (elody:readsHost)."@en .

# ---- 0.3.0, batch 21: shared fragments of their own (G-020) -----------------------------------

elody:fragmentsOnly a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "fragments only"@en ; rdfs:domain elody:EntityUi ; rdfs:range xsd:boolean ;
  rdfs:comment "true declares a file of shared fragments alone (values, panel, filters, fields and elements fragments other types spread): no listing, detail or documents of its own; elody:graphqlType is the anchor type."@en .
elody:filePath a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "file path"@en ; rdfs:domain elody:EntityUi ; rdfs:range xsd:string ;
  rdfs:comment "The file the documents are written to, relative to src/ (default queries/entities/<name>.queries.ts)."@en .
elody:PanelFragment a owl:Class ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "panel fragment"@en ;
  rdfs:comment "A shared fragment on WindowElementPanel: panel fields other types spread into a panel (elody:spread)."@en .
elody:panelFragment a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "panel fragment"@en ; rdfs:domain elody:EntityUi ; rdfs:range elody:PanelFragment ;
  rdfs:comment "A panel fields fragment the file holds: elody:fragmentName and the property shapes shown, by their sh:path."@en .
elody:FiltersFragment a owl:Class ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "filters fragment"@en ;
  rdfs:comment "A shared fragment on AdvancedFilters: filters other types spread into theirs (elody:filtersSpread)."@en .
elody:filtersFragment a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "filters fragment"@en ; rdfs:domain elody:EntityUi ; rdfs:range elody:FiltersFragment ;
  rdfs:comment "A filters fragment the file holds: elody:fragmentName and its elody:filter nodes."@en .
elody:cardMenuSpread a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "card menu spread"@en ; rdfs:domain elody:PickerResult ; rdfs:range xsd:string ;
  rdfs:comment "A hand-written menu fragment spread on the result's card next to its listing fragment (teaserMetadata { buttons { contextMenu { ...X } } })."@en .
elody:valuesField a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "values field"@en ; rdfs:domain elody:ValuesFragment ; rdfs:range xsd:string ;
  rdfs:comment "A plain field of IntialValues the fragment reads next to its keyValues (lockedProperties), one per value."@en .
elody:fieldAlias a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "field alias"@en ; rdfs:domain elody:ValuesFragment ; rdfs:range xsd:string ;
  rdfs:comment "A property shape the fragment reads, referenced by its elody:alias (when several shapes share a key, e.g. two type pills over the type)."@en .
elody:menuSpread a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "menu spread"@en ; rdfs:domain elody:ContextMenu ; rdfs:range xsd:string ;
  rdfs:comment "A hand-written fragment of menu actions spread in the menu (...linkAndDeleteEntityContextMenuActions); elody:includeBasicActions is the platform's own."@en .
elody:bareValues a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "bare values"@en ; rdfs:domain elody:OptionsInput ; rdfs:range xsd:boolean ;
  rdfs:comment "true writes the input's values as enum values (value: [asset, institution]) rather than strings."@en .
elody:optionsTypeBare a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "options type bare"@en ; rdfs:domain elody:Filter ; rdfs:range xsd:boolean ;
  rdfs:comment "true writes elody:optionsType as an enum value ({ type: type, value: user }) rather than a string."@en .
elody:cardShows a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "card shows"@en ; rdfs:domain elody:ValuesFragment ; rdfs:range xsd:string ;
  rdfs:comment "A value (by its alias, else its key) the card twin shows, one per value; without it the card shows every value the fragment reads."@en .

# ---- 0.3.0, batch 22: what a filter and its option search may still say (G-013) ----------------

elody:optionsKeys a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "options keys"@en ; rdfs:domain elody:Filter ; rdfs:range rdf:List ;
  rdfs:comment "Several keys the option search searches (key: [...] on the text input), an RDF list; one key is elody:optionsKey."@en .
elody:optionsItemTypes a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "options item types"@en ; rdfs:domain elody:Filter ; rdfs:range xsd:string ;
  rdfs:comment "An entity type the option search is limited to (item_types on the text input), one per value."@en .
elody:optionsLabelKey a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "options label key"@en ; rdfs:domain elody:Filter ; rdfs:range xsd:string ;
  rdfs:comment "The metadata key labelling the options found (metadata_key_as_label on the text input)."@en .
elody:itemTypes a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "item types"@en ; rdfs:domain elody:Filter ; rdfs:range xsd:string ;
  rdfs:comment "An entity type a relation filter picks from (itemTypes: [...]), one per value."@en .
elody:defaultMatcher a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "default matcher"@en ; rdfs:domain elody:Filter ; rdfs:range xsd:string ;
  rdfs:comment "The matcher a text filter starts with (defaultMatcher: ExactInputMatcher), a Matchers value."@en .
elody:allowedMatchers a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "allowed matchers"@en ; rdfs:domain elody:Filter ; rdfs:range rdf:List ;
  rdfs:comment "The matchers a text filter offers (allowedMatchers: [...]), an RDF list of Matchers values."@en .
elody:lookupResolveToSourceIds a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "lookup resolves to source ids"@en ; rdfs:domain elody:Lookup ; rdfs:range xsd:boolean ;
  rdfs:comment "true resolves the looked-up documents to the ids of the source entities (resolve_to_source_ids)."@en .
elody:ValueMapping a owl:Class ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "value mapping"@en ;
  rdfs:comment "Values a filter's default is mapped from (defaultValueMapping: a list of values and what they map to)."@en .
elody:valueMapping a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "value mapping"@en ; rdfs:domain [ a owl:Class ; owl:unionOf ( elody:Filter elody:OptionsInput ) ] ; rdfs:range elody:ValueMapping ;
  rdfs:comment "A mapping of the default value, in sh:order: elody:value lists the values, elody:mapping what they become."@en .
elody:mapping a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "mapping"@en ; rdfs:domain elody:ValueMapping ; rdfs:range xsd:string ;
  rdfs:comment "What the listed values map to (mapping: \"jeugd\")."@en .
elody:Facet a owl:Class ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "facet"@en ;
  rdfs:comment "A facet of a filter (facets): a kind and value, or a key reached over lookups, with facets of its own."@en .
elody:facet a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "facet"@en ; rdfs:domain [ a owl:Class ; owl:unionOf ( elody:Filter elody:Facet ) ] ; rdfs:range elody:Facet ;
  rdfs:comment "A facet, in sh:order: elody:inputKind and elody:value, or elody:key with elody:lookup nodes, and nested elody:facet nodes."@en .

# ---- 0.3.0, batch 23: what a guided flow and its steps may still say (G-041) -------------------

elody:linear a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "linear"@en ; rdfs:domain elody:GuidedFlow ; rdfs:range xsd:boolean ;
  rdfs:comment "true runs the steps one after another (linear)."@en .
elody:startOnFirstStep a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "start on first step"@en ; rdfs:domain elody:GuidedFlow ; rdfs:range xsd:boolean ;
  rdfs:comment "true opens the flow on its first step (startOnFirstStep)."@en .
elody:returnsSelection a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "returns selection"@en ; rdfs:domain elody:GuidedFlow ; rdfs:range xsd:boolean ;
  rdfs:comment "true hands the selection back to where the flow was opened instead of creating relations (returnsSelection)."@en .
elody:routeToStep a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "route to step"@en ; rdfs:domain elody:GuidedFlow ; rdfs:range xsd:string ;
  rdfs:comment "The step whose entity the PWA navigates to when the flow finishes (routeToStep)."@en .
elody:routeToRoute a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "route to route"@en ; rdfs:domain elody:GuidedFlow ; rdfs:range xsd:string ;
  rdfs:comment "The PWA route the flow navigates to when it finishes (routeToRoute: WemOverview), an open string of the PWA's."@en .
elody:showBackButton a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "show back button"@en ; rdfs:domain elody:FlowStep ; rdfs:range xsd:boolean ;
  rdfs:comment "Whether the step shows a back button (showBackButton)."@en .
elody:skipSearchIfPriorIsNew a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "skip search if prior is new"@en ; rdfs:domain elody:FlowStep ; rdfs:range xsd:boolean ;
  rdfs:comment "true skips the step's search when the prior step created a new entity (skipSearchIfPriorIsNew)."@en .
elody:pickerFiltersCollapsed a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "picker filters collapsed"@en ; rdfs:domain elody:FlowStep ; rdfs:range xsd:boolean ;
  rdfs:comment "Whether the step's picker starts with its filters collapsed (pickerFiltersCollapsed)."@en .
elody:metadataOnly a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "metadata only"@en ; rdfs:domain elody:FlowStep ; rdfs:range xsd:boolean ;
  rdfs:comment "true makes the step edit only the metadata of the relation to the prior step, without picking or creating an entity (metadataOnly)."@en .
elody:terminalActionLabel a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "terminal action label"@en ; rdfs:domain elody:FlowStep ; rdfs:range xsd:string ;
  rdfs:comment "The translation key of the action that ends the flow at this step (terminalActionLabel)."@en .
elody:StepScope a owl:Class ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "step scope"@en ;
  rdfs:comment "The scope of a step's search: the entities related to what a prior step chose (scopeToRelationOf)."@en .
elody:scopeToRelationOf a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "scope to relation of"@en ; rdfs:domain elody:FlowStep ; rdfs:range elody:StepScope ;
  rdfs:comment "The prior step (elody:fromStep), the relation type and the filter key the search is scoped by."@en .
elody:filterKey a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "filter key"@en ; rdfs:domain elody:StepScope ; rdfs:range xsd:string ;
  rdfs:comment "The key the scoped search filters on (filterKey)."@en .
elody:StepRelation a owl:Class ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "step relation"@en ;
  rdfs:comment "A relation the flow creates from this step's entity to a prior step's (relations)."@en .
elody:stepRelation a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "step relation"@en ; rdfs:domain elody:FlowStep ; rdfs:range elody:StepRelation ;
  rdfs:comment "A relation to create, in sh:order: elody:to names the prior step, elody:relationType the relation, elody:createWhen when (always)."@en .
elody:to a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "to"@en ; rdfs:domain elody:StepRelation ; rdfs:range xsd:string ;
  rdfs:comment "The key of the step the relation goes to (to)."@en .
elody:createWhen a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "create when"@en ; rdfs:domain elody:StepRelation ; rdfs:range xsd:string ;
  rdfs:comment "When the relation is created (createWhen: always), a platform enum value."@en .
elody:RelationMetadataField a owl:Class ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "relation metadata field"@en ;
  rdfs:comment "A form field whose value is stored as metadata on the relation a step creates (metadataFields)."@en .
elody:metadataField a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "metadata field"@en ; rdfs:domain elody:StepRelation ; rdfs:range elody:RelationMetadataField ;
  rdfs:comment "A field of the step's form copied onto the relation, in sh:order: elody:formMetadataKey names the form field, elody:relationMetadataKey the relation metadata key, elody:asArray stores it as a list."@en .
elody:formMetadataKey a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "form metadata key"@en ; rdfs:domain elody:RelationMetadataField ; rdfs:range xsd:string ;
  rdfs:comment "The key of the form field whose value is copied (formMetadataKey)."@en .
elody:relationMetadataKey a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "relation metadata key"@en ; rdfs:domain elody:RelationMetadataField ; rdfs:range xsd:string ;
  rdfs:comment "The relation metadata key the value is stored under (relationMetadataKey)."@en .
elody:asArray a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "as array"@en ; rdfs:domain elody:RelationMetadataField ; rdfs:range xsd:boolean ;
  rdfs:comment "true stores the value as a list (asArray)."@en .
elody:CreatableType a owl:Class ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "creatable type"@en ;
  rdfs:comment "A type a step may create, with the form that creates it (creatableTypes)."@en .
elody:creatableType a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "creatable type"@en ; rdfs:domain elody:FlowStep ; rdfs:range elody:CreatableType ;
  rdfs:comment "A type the step may create, in sh:order: elody:labelKey, elody:entityType and the elody:form that creates it."@en .

# ---- 0.3.0, batch 24: a type's other cards, its orphan documents, the signed-in user (G-019) ----

elody:cardName a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "card name"@en ; rdfs:domain elody:EntityUi ; rdfs:range xsd:string ;
  rdfs:comment "The listing fragment's own name when the client does not call it minimal<X>: a second card of a type for another place (mediafileAsPreview, the card the platform's GetMediafilesAsPreview shows), declared as another EntityUi of the GraphQL type with its own elody:documentName."@en .
elody:SortDocument a owl:Class ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "sort options document"@en ;
  rdfs:comment "A sort options document of its own (EntityTypeSortOptions with its options inline), for a page the type's standard sort options do not serve (GetSortOptionsForComments)."@en .
elody:sortDocument a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "sort document"@en ; rdfs:domain elody:EntityUi ; rdfs:range elody:SortDocument ;
  rdfs:comment "A sort options document of the type with options of its own: elody:queryName names it, elody:sortOption lists the options in sh:order."@en .
elody:SortOption a owl:Class ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "sort option"@en ;
  rdfs:comment "An option of a sort options document: elody:labelKey, elody:value (the sort key), elody:primary, elody:icon."@en .
elody:sortOption a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "sort option"@en ; rdfs:domain elody:SortDocument ; rdfs:range elody:SortOption ;
  rdfs:comment "An option of the document, in sh:order."@en .
elody:inputResolveDefaultValueToOptionIds a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "input resolves default value to option ids"@en ; rdfs:domain elody:OptionsInput ; rdfs:range xsd:boolean ;
  rdfs:comment "true resolves the input's value (session-$id) to the ids of the options it matches, which become the filter's default (resolveDefaultValueToOptionIds)."@en .
elody:keepDefaultValue a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "keep default value"@en ; rdfs:domain elody:Filter ; rdfs:range xsd:boolean ;
  rdfs:comment "true keeps the filter's default value when the user changes the filters (doNotOverrideDefaultValue)."@en .

# ---- 0.3.0, batch 25: the preview of a type (G-016) -------------------------------------------

elody:Preview a owl:Class ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "preview"@en ;
  rdfs:comment "How a type is previewed from a list (previewComponent, the previewFor<X> fragment the platform's getPreviewComponents spreads): its kind, how many list items it covers, its title, whether it opens by default, and the layouts it loads."@en .
elody:preview a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "preview"@en ; rdfs:domain elody:EntityUi ; rdfs:range elody:Preview ;
  rdfs:comment "The preview of the type."@en .
elody:PreviewKind a owl:Class ; rdfs:label "preview kind"@en ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:comment "Enumeration of preview kinds (PreviewTypes): a column of elements, the media viewer, a map, the history."@en .
elody:ColumnListPreview a elody:PreviewKind ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:MediaViewerPreview a elody:PreviewKind ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:MapPreview a elody:PreviewKind ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:HistoryPreview a elody:PreviewKind ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:previewKind a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "preview kind"@en ; rdfs:domain elody:Preview ; rdfs:range elody:PreviewKind ;
  rdfs:comment "The kind of preview (type)."@en .
elody:ListItemCoverage a owl:Class ; rdfs:label "list item coverage"@en ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:comment "Enumeration of how many list items a preview covers (ListItemCoverageTypes): one, or all of them."@en .
elody:OneListItem a elody:ListItemCoverage ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:AllListItems a elody:ListItemCoverage ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:coverage a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "coverage"@en ; rdfs:domain elody:Preview ; rdfs:range elody:ListItemCoverage ;
  rdfs:comment "How many list items the preview covers (listItemsCoverage)."@en .
elody:openByDefault a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "open by default"@en ; rdfs:domain elody:Preview ; rdfs:range xsd:boolean ;
  rdfs:comment "Whether the preview opens by default (openByDefault)."@en .
elody:showCurrentPreviewFlow a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "show current preview flow"@en ; rdfs:domain elody:Preview ; rdfs:range xsd:boolean ;
  rdfs:comment "Whether the preview shows the current preview flow (showCurrentPreviewFlow)."@en .
elody:keepLastActiveItemHighlighted a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "keep last active item highlighted"@en ; rdfs:domain elody:Preview ; rdfs:range xsd:boolean ;
  rdfs:comment "Whether the list keeps the last previewed item highlighted (previewConfiguration keepLastActiveItemHighlighted)."@en .
elody:displayOpenDetailPageButton a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "display open detail page button"@en ; rdfs:domain elody:Preview ; rdfs:range xsd:boolean ;
  rdfs:comment "Whether the preview offers a button opening the detail page (previewConfiguration displayOpenDetailPageButton)."@en .
elody:PreviewLayout a owl:Class ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "preview layout"@en ;
  rdfs:comment "A document of elements the preview loads (PreviewElement: a column of elements, like the detail layout), named by elody:queryName (GetPreviewInX, GetMetadataPreviewForX)."@en .
elody:previewLayout a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "preview layout"@en ; rdfs:domain elody:Preview ; rdfs:range elody:PreviewLayout ;
  rdfs:comment "The layout the preview loads (previewQuery)."@en .
elody:metadataPreviewLayout a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "metadata preview layout"@en ; rdfs:domain elody:Preview ; rdfs:range elody:PreviewLayout ;
  rdfs:comment "The layout of metadata the preview shows next to the item (metadataPreviewQuery)."@en .
elody:WindowLayout a owl:Class ; rdfs:label "window layout"@en ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:comment "Enumeration of window element layouts (WindowElementLayout): the panels below each other, or in a horizontal grid."@en .
elody:VerticalLayout a elody:WindowLayout ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:HorizontalGridLayout a elody:WindowLayout ; rdfs:isDefinedBy <https://elody.eu/ns/ui> .
elody:windowLayout a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "window layout"@en ; rdfs:domain elody:WindowElement ; rdfs:range elody:WindowLayout ;
  rdfs:comment "How the window lays out its panels (layout)."@en .
elody:panelHeader a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "panel header"@en ; rdfs:domain elody:Panel ; rdfs:range xsd:boolean ;
  rdfs:comment "false renders the panel without a header (no panelHeaderContent): the panels of a metadata preview. Without it the panel is headed with its label."@en .

# ---- 0.3.0, batch 26: the comments element rendered (G-042) ------------------------------------

elody:extensions a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "extensions"@en ; rdfs:domain elody:WysiwygElement ; rdfs:range rdf:List ;
  rdfs:comment "The editor features switched on, in order (extensions: an RDF list of elody:WysiwygExtension instances); elody:extension says the same unordered."@en .
elody:editorStyles a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "editor styles"@en ; rdfs:domain elody:WysiwygElement ; rdfs:range xsd:string ;
  rdfs:comment "CSS classes of the editor (wysiwygElementConfiguration customEditorStyles). Open string: the PWA's."@en .
elody:CreateField a owl:Class ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "create field"@en ;
  rdfs:comment "A field filled in when a comment is created, next to its body (createFields): the metadata key, its label, the input field."@en .
elody:createField a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "create field"@en ; rdfs:domain elody:CommentsElement ; rdfs:range elody:CreateField ;
  rdfs:comment "A field of the comment create form, in sh:order: elody:key, elody:labelKey, elody:clientInputField."@en .
elody:Taggable a owl:Class ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "taggable"@en ;
  rdfs:comment "What a rich-text editor can tag (taggableEntityConfiguration): entities of a type, found through a filter key on an inline trigger, or picked through a guided flow."@en .
elody:taggable a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "taggable"@en ; rdfs:domain elody:WysiwygElement ; rdfs:range elody:Taggable ;
  rdfs:comment "A taggable of the editor, in sh:order: elody:tag, elody:entityType, elody:relationType, elody:tagFilterKey, elody:triggerCharacter, elody:triggerMinCharacters, elody:flow, elody:flowButtonLabel."@en .
elody:tag a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "tag"@en ; rdfs:domain elody:Taggable ; rdfs:range xsd:string ;
  rdfs:comment "The name of the tag (tag: user, group, entity)."@en .
elody:tagFilterKey a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "tag filter key"@en ; rdfs:domain elody:Taggable ; rdfs:range xsd:string ;
  rdfs:comment "The metadata key the typed tag content is searched in (metadataFilterForTagContent)."@en .
elody:triggerCharacter a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "trigger character"@en ; rdfs:domain elody:Taggable ; rdfs:range xsd:string ;
  rdfs:comment "The character that opens tagging inline (inlineTrigger character: @)."@en .
elody:triggerMinCharacters a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "trigger minimum characters"@en ; rdfs:domain elody:Taggable ; rdfs:range xsd:integer ;
  rdfs:comment "How many characters are typed before suggestions appear (inlineTrigger minCharacters)."@en .
elody:flow a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "flow"@en ; rdfs:domain elody:Taggable ; rdfs:range elody:GuidedFlow ;
  rdfs:comment "The guided flow that picks what is tagged (guidedFlowQuery), a declared elody:GuidedFlow."@en .
elody:flowButtonLabel a owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "flow button label"@en ; rdfs:domain elody:Taggable ; rdfs:range xsd:string ;
  rdfs:comment "The translation key of the button that opens the flow (guidedFlowButtonLabel)."@en .

# ---- 0.3.0, batch 27: the graph element rendered (G-033) ---------------------------------------

elody:datasetLabels a owl:ObjectProperty ;
  rdfs:isDefinedBy <https://elody.eu/ns/ui> ;
  rdfs:label "dataset labels"@en ; rdfs:domain elody:GraphElement ; rdfs:range rdf:List ;
  rdfs:comment "The series to plot, in order (dataset labels: an RDF list of strings, empty for every series); elody:datasetLabel says the same unordered."@en .
