@prefix elody:  <https://elody.eu/ns/ui#> .
@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix shui:   <http://www.w3.org/ns/shacl-ui/> .
@prefix dash:   <http://datashapes.org/dash#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix ui:     <urn:fixture:ui#> .
@prefix em:     <https://elody.io/ns/metadata#> .

# 0.3.0, batch 12: a list query whose results are rendered inline, from a listing declared for
# that document alone (elody:emit "inline"), next to a fragment spread.

ui:WorkUi
  a elody:EntityUi ;
  elody:graphqlType "Work" ;
  elody:emit "file" ;
  sh:property [ sh:path em:title ; sh:name "title"@en ; sh:order 1 ; shui:propertyRole shui:LabelRole ] ;
  elody:detail
    [ elody:column [ sh:order 1 ; elody:element
      [ a elody:ListElement ; rdfs:label "element-labels.authors" ; sh:order 1 ; elody:alias "Authors" ; elody:collapsed false ;
        elody:entityTypes "person" ; elody:relationType "refAuthors" ; elody:listQuery ui:GetAuthors ] ] ] .

ui:GetAuthors
  a elody:ListQuery ;
  elody:queryName "GetAuthors" ;
  elody:filtersQuery "GetAuthorsInWorkFilters" ;
  elody:relationValues true ;
  elody:readsHost true ;
  elody:result
    [ elody:graphqlType "Person" ; sh:order 1 ; elody:listing ui:PersonInGetAuthorsUi ] ,
    [ elody:graphqlType "Corporation" ; sh:order 2 ; elody:fragment "minimalCorporation" ; elody:listing ui:CorporationInGetAuthorsUi ] ;
  elody:filter [ sh:order 1 ; elody:alias "type" ; dash:hidden true ; sh:defaultValue "person" ; elody:filterKind elody:TypeFilter ] .

ui:PersonInGetAuthorsUi
  a elody:EntityUi ;
  elody:graphqlType "Person" ;
  elody:documentName "PersonInGetAuthors" ;
  elody:emit "inline" ;
  elody:relationValues true ;
  sh:property
    [ sh:path em:name ; sh:name "name"@en ; sh:order 1 ; shui:propertyRole shui:LabelRole ; elody:labelKey "metadata.labels.name" ] ,
    [ sh:path em:life_dates ; sh:order 2 ; elody:labelKey "metadata.labels.life-dates" ] ,
    [ sh:path em:main_author ; sh:order 3 ; elody:source elody:RelationMetadataSource ; elody:relationKey "refAuthors" ; elody:readsHost true ; elody:labelKey "metadata.labels.main-author" ] ,
    [ sh:path em:volume ; sh:order 4 ; elody:source elody:RelationMetadataSource ; elody:relationKey "refSeries" ; elody:readsHost true ; elody:relationDirection "fromRelatedEntity" ; elody:teaser false ] ,
    [ sh:path em:domein ; sh:order 5 ; elody:key "title" ; elody:alias "domein" ; elody:source elody:ParentMetadataSource ; elody:parentEntityType "zizo" ; elody:parentKey "vlacc:1|properties.ref_sub_zizos.value" ; elody:teaser false ] ,
    [ sh:path em:roles ; sh:order 6 ; elody:source elody:RelationRootdataSource ; elody:relationKey "isUserFor" ; elody:readsHost true ; elody:cardField "relationRootData" ; elody:cardEditable true ; elody:clientInputField "rolesTypeField" ; elody:labelKey "metadata.labels.roles" ] ,
    [ sh:path em:function_indication ; sh:order 7 ; sh:minCount 1 ; elody:source elody:RelationMetadataSource ; elody:relationKey "refAuthors" ; elody:readsHost true ; elody:cardField "relationMetaData" ; elody:cardEditable true ; elody:clientInputField "workFunctionTypeField" ; elody:labelKey "metadata.labels.function-indication" ] ;
  elody:viewMode [ sh:order 1 ; elody:mode elody:ListView ] .

ui:CorporationInGetAuthorsUi
  a elody:EntityUi ;
  elody:graphqlType "Corporation" ;
  elody:documentName "CorporationInGetAuthors" ;
  elody:emit "inline" ;
  sh:property [ sh:path em:name ; sh:name "name"@en ; sh:order 1 ; shui:propertyRole shui:LabelRole ; elody:labelKey "metadata.labels.name" ; elody:readsValue false ] ;
  elody:contextMenu [ elody:menuInButtons true ; elody:action [ sh:order 1 ; elody:alias "doLinkAction" ; elody:actionForm "doLinkAction" ; rdfs:label "contextMenu.contextMenuLinkAction.followLink" ; elody:icon "AngleRight" ] ] .
