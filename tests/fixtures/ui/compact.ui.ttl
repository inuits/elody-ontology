@prefix elody: <https://elody.eu/ns/ui#> .
@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix shui:  <http://www.w3.org/ns/shacl-ui/> .
@prefix dash:  <http://datashapes.org/dash#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix ui:    <https://example.org/compact/ui#> .
@prefix em:    <https://elody.io/ns/metadata#> .

# Batch 48 fixture: the compact form. Every default left out: the label keys follow the convention
# (metadata.labels.<key>, elody:defaultRule), the panel and the element start open (elody:collapsed,
# sh:defaultValue false), no sh:name. `elody-ui expand` writes them all back.

ui:BookUi
  a elody:EntityUi ;
  elody:graphqlType "Book" ;
  elody:emit "file" ;
  elody:documents "entities" ;
  sh:property
    [ sh:path em:title ; sh:order 1 ; shui:propertyRole shui:LabelRole ; sh:datatype xsd:string ] ,
    [ sh:path em:publicationYear ; sh:order 2 ; sh:datatype xsd:string ] ,
    [ sh:path em:isbn ; sh:order 3 ; elody:labelKey "metadata.labels.book.isbn" ; elody:teaser false ] ;
  elody:viewMode [ sh:order 1 ; elody:mode elody:ListView ] ;
  elody:detail
    [ elody:column
      [ sh:order 1 ; elody:size elody:Width100 ;
      elody:element
        [ a elody:WindowElement ; rdfs:label "window-element-labels.info" ; sh:order 1 ; elody:panel ui:BookUi-info ] ] ] ;
  elody:filter
    [ sh:order 1 ; elody:alias "type" ; dash:hidden true ; sh:defaultValue "book" ; elody:filterKind elody:TypeFilter ] .

ui:BookUi-info
  a elody:Panel ;
  rdfs:label "panel-labels.info" ;
  sh:order 1 ;
  elody:alias "info" ;
  elody:panelKind elody:MetadataPanel ;
  elody:field em:title , em:publicationYear , em:isbn .
