@prefix elody:  <https://elody.eu/ns/ui#> .
@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix shui:   <http://www.w3.org/ns/shacl-ui/> .
@prefix dash:   <http://datashapes.org/dash#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix ui:     <urn:fixture:ui#> .
@prefix em:     <https://elody.io/ns/metadata#> .

# 0.3.0: a property read under another GraphQL alias (title: keyValue(key: "email")),
# a card thumbnail, a panel laid out in several columns, a form tab alias and a submit that
# shows form errors, a column without a size,
# a field read on the detail page only, a sort option with its own label and position,
# a type that reads no relation values and carries no bulk operations, a type without
# view modes, and a hidden selection filter with an empty default list and a parent key.

ui:UserUi
  a elody:EntityUi ;
  elody:graphqlType "User" ;
  elody:emit "file" ;
  elody:relationValues false ;
  elody:bulkOperations false ;
  elody:thumbnail [ elody:fromMediafile true ] ;
  elody:listingValuesSpread "vocabTeaserIntialValues" ;
  elody:detailValuesSpread "entityAuditIntialValues" ;
  elody:cardSpread "vocabTeaserMetadata" ;
  elody:filtersSpread "entityAuditFilters" ;
  elody:form ui:CreateUser ;
  elody:detail
    [ elody:column
      [ sh:order 1 ;
      elody:element
        [ a elody:WindowElement ;
        rdfs:label "window-element-labels.info-window" ;
        sh:order 1 ;
        elody:alias "info" ;
        elody:panel ui:UserUi-info ] ,
        [ a elody:ListElement ;
        rdfs:label "element-labels.tenants" ;
        sh:order 2 ;
        elody:alias "Tenants" ;
        elody:entityTypes "tenant" ;
        elody:relationType "hasTenant" ;
        elody:listQuery ui:GetTenantsOfUser ] ] ] ;
  sh:property
    [ sh:path em:email ;
    sh:name "Email"@en ;
    sh:order 1 ;
    shui:propertyRole shui:LabelRole ;
    elody:labelKey "metadata.labels.email" ;
    elody:sortable true ;
    elody:sortLabelKey "metadata.labels.user.email" ;
    elody:sortOrder 2 ] ,
    [ sh:path em:id ;
    sh:order 2 ;
    elody:alias "slug" ;
    elody:source elody:RootSource ;
    elody:teaser false ] ,
    [ sh:path em:first_name ;
    sh:name "First name"@en ;
    sh:order 3 ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    elody:labelKey "metadata.labels.firstName" ;
    elody:detailOnly true ] ,
    [ sh:path em:email ;
    sh:order 4 ;
    elody:alias "title" ;
    elody:detailOnly true ] ,
    [ sh:path em:name ;
    sh:order 5 ;
    elody:labelKey "metadata.labels.user.name" ;
    elody:sortable true ;
    elody:sortOrder 1 ;
    elody:detailOnly true ] ,
    [ sh:path em:language ;
    sh:name "Language"@en ;
    sh:order 6 ;
    sh:class em:Language ;
    elody:valueLabelKey "title" ;
    elody:clientInputField "languageTypeField" ;
    elody:labelKey "metadata.labels.language" ;
    elody:detailOnly true ] ;
  elody:filter
    [ sh:order 1 ;
    elody:alias "type" ;
    dash:hidden true ;
    sh:defaultValue "user" ;
    elody:filterKind elody:TypeFilter ] ,
    [ rdfs:label "metadata.labels.language" ;
    sh:order 3 ;
    elody:alias "language" ;
    elody:key "vliz:1|properties.has_language.value" ;
    elody:displayedByDefault true ;
    elody:optionsType "language" ;
    elody:optionsKey "vliz:1|properties.title.value" ;
    elody:filterKind elody:SelectionFilter ;
    elody:showTooltip true ] ,
    [ sh:order 2 ;
    elody:alias "relation" ;
    elody:key "isTenantFor" ;
    elody:parentFilterKey "relations" ;
    dash:hidden true ;
    elody:defaultValueAsList true ;
    elody:showTooltip true ;
    elody:filterKind elody:SelectionFilter ;
    elody:keyAsList false ] .

ui:TenantUi
  a elody:EntityUi ;
  elody:graphqlType "Tenant" ;
  elody:emit "file" ;
  sh:property
    [ sh:path em:label ;
    sh:name "Name"@en ;
    sh:order 1 ;
    shui:propertyRole shui:LabelRole ;
    elody:labelKey "metadata.labels.name" ] .

ui:UserUi-info
  a elody:Panel ;
  rdfs:label "panel-labels.user-info" ;
  sh:order 1 ;
  elody:alias "info" ;
  elody:panelKind elody:MetadataPanel ;
  elody:multipleColumns true ;
  elody:spread "entityAuditMetadata" ;
  elody:field em:first_name , em:language .

ui:CreateUser
  a elody:Form ;
  rdfs:label "navigation.create-user" ;
  elody:queryName "GetUserCreateForm" ;
  elody:alias "user" ;
  elody:shape [ sh:property [ sh:path em:email ; sh:name "Email"@en ; sh:order 1 ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:minCount 1 ] ] ;
  elody:submit
    [ rdfs:label "actions.labels.create" ;
    elody:actionQuery "CreateEntity" ;
    elody:creationType "user" ;
    elody:icon "Create" ;
    elody:showsFormErrors true ] .

# the list's documents: GetTenantsOfUser (results per type) and GetTenantsOfUserFilters (the type, the relation)
ui:GetTenantsOfUser
  a elody:ListQuery ;
  elody:queryName "GetTenantsOfUser" ;
  elody:result [ elody:graphqlType "Tenant" ; sh:order 1 ; elody:fragment "minimalTenant" ] ;
  elody:filter
    [ sh:order 1 ; dash:hidden true ; sh:defaultValue "tenant" ; elody:filterKind elody:TypeFilter ] ,
    [ sh:order 2 ; elody:alias "relation" ; elody:key "elody:1|identifiers" ; dash:hidden true ;
      sh:defaultValue "$entity.relationValues.hasTenant.key" ; elody:filterKind elody:SelectionFilter ] .
